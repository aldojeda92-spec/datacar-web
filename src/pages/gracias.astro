                <div class="relative w-24 h-24 bg-[#00BFFF] rounded-full flex items-center justify-center shadow-[0_0_50px_rgba(0,191,255,0.4)]">
                    <svg class="w-12 h-12 text-[#0A1F33]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">

-- TABLA 1: El Inventario de Autos (Los datos duros)
CREATE TABLE vehiculos (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    marca VARCHAR(50) NOT NULL,
    modelo VARCHAR(50) NOT NULL,
    version VARCHAR(50),
    categoria VARCHAR(30), -- Ej: SUV, Sedan
    precio_usd NUMERIC(10, 2) NOT NULL,
    motor VARCHAR(50),
    transmision VARCHAR(30),
    airbags INTEGER,
    score_base INTEGER DEFAULT 50, -- Usado para el algoritmo inicial
    activo BOOLEAN DEFAULT TRUE
);

-- TABLA 2: Los Leads (El Perfil que captura el Paso 1)
CREATE TABLE leads (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    fecha_creacion TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    nombre_completo VARCHAR(100) NOT NULL,
    telefono VARCHAR(20) NOT NULL,
    email VARCHAR(100),
    presupuesto_min NUMERIC(10, 2),
    presupuesto_max NUMERIC(10, 2),
    categoria_buscada VARCHAR(30),
    prioridades JSONB, -- Ej: ["Seguridad", "Espacio"]
    uso_principal VARCHAR(50),
    composicion_familiar VARCHAR(50),
    solo_tradicionales BOOLEAN
);

-- TABLA 3: El Dossier IA (La resultante de la IA y las selecciones)
CREATE TABLE dossiers (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    lead_id UUID REFERENCES leads(id) ON DELETE CASCADE,
    fecha_generacion TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    vehiculos_seleccionados JSONB, -- Array de IDs de los 5 autos que eligió
    ganador_id UUID REFERENCES vehiculos(id),
    racional_ia JSONB, -- El texto estructurado que devuelve Gemini/GPT
    vehiculo_interes VARCHAR(100), -- Si hace click en "Quiero Cotizar"
    estado_venta VARCHAR(30) DEFAULT 'Nuevo' -- 'Nuevo', 'Contactado', 'Cerrado'
);

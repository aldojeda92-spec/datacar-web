        <section id="comparador" class="py-24 bg-[#F5F7FA] border-y border-gray-200">
            <div class="max-w-7xl mx-auto px-4">
                <div class="text-center mb-10">
                    <h2 class="text-3xl md:text-4xl font-[900] text-[#0A1F33] mb-4 uppercase">Comparador Técnico</h2>

            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </a>

        <script type="module" is:inline>
            import Papa from 'https://cdn.jsdelivr.net/npm/papaparse@5.4.1/+esm';

            const URL_CSV = "https://docs.google.com/spreadsheets/d/e/2PACX-1vQgA9AGiaH-RdEQrO2mOSjNDe7_zPoBMZyp-Yzmc0IKkTo9CluAzhWRJ9JXT-4XgNAAgiF-Uzzsea5m/pub?output=csv";
            const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyTBqtK9wDzl10vc226zFwn4f-v-DVjKCfo9JVj3XCcepIcw41NQHchLrbDK6mz1zWgWg/exec';

            let bdAutosOriginal = []; 
            let bdAutos = []; 
            let autoA = null, autoB = null;
            let arbolFiltros = {};
            let columnaAA = 'Tipo Carrocería'; 

            // Formulario directo a Excel
            const form = document.getElementById('lead-form');
            const btn = document.getElementById('submit-btn');

            form?.addEventListener('submit', e => {
                e.preventDefault();
                btn.disabled = true; btn.innerText = "Enviando...";

                fetch(SCRIPT_URL, { method: 'POST', body: new FormData(form)})
                    .then(() => {
                        window.dataLayer = window.dataLayer || [];
                        window.dataLayer.push({'event': 'lead_success', 'form_name': 'home_lead'});
                        window.location.href = '/gracias';
                    })
                    .catch(() => {
                        alert('Error al enviar. Por favor intentá vía WhatsApp.');
                        btn.disabled = false; btn.innerText = "Enviar solicitud";
                    });
            });

            async function iniciarComparador() {
                try {
                    const res = await fetch(URL_CSV, { cache: "no-store" });
                    const csvText = await res.text();
                    
                    Papa.parse(csvText, {
                        header: true, skipEmptyLines: true, transformHeader: h => h.trim(),
                        complete: function(results) {
                            bdAutosOriginal = results.data.filter(c => c['Marca'] && c['Marca'].trim() !== "");
                            
                            const headers = results.meta.fields;
                            if (headers.length > 26) columnaAA = headers[26]; 

                            // Agrupación Jerárquica de Carrocerías
                            const tiposRaw = [...new Set(bdAutosOriginal.map(c => c[columnaAA]?.trim()).filter(Boolean))].sort();
                            const grupos = { 'SUV': [], 'Pick-up': [], 'Sedán': [], 'Hatchback': [], 'Furgón': [], 'Otros': [] };

                            tiposRaw.forEach(t => {
                                let tl = t.toLowerCase();
                                if (tl.includes('suv')) grupos['SUV'].push(t);
                                else if (tl.includes('pick-up') || tl.includes('pickup')) grupos['Pick-up'].push(t);
                                else if (tl.includes('sedán') || tl.includes('sedan')) grupos['Sedán'].push(t);
                                else if (tl.includes('hatchback')) grupos['Hatchback'].push(t);
                                else if (tl.includes('furgón') || tl.includes('van')) grupos['Furgón'].push(t);
                                else grupos['Otros'].push(t);
                            });

                            const selectTipo = document.getElementById('filtroTipo');
                            for (const [nombre, items] of Object.entries(grupos)) {
                                if (items.length > 0) {
                                    const grp = document.createElement('optgroup'); grp.label = nombre;
                                    items.forEach(i => grp.add(new Option(i, i)));
                                    selectTipo.appendChild(grp);
                                }
                            }

                            // Event Listeners
                            document.getElementById('filtroTipo').addEventListener('change', aplicarFiltrosGlobales);
                            document.getElementById('filtroPrecio').addEventListener('change', aplicarFiltrosGlobales);
                            document.getElementById('filtroCombustible').addEventListener('change', aplicarFiltrosGlobales);
                            document.getElementById('btnLimpiar').addEventListener('click', () => {
                                document.getElementById('filtroTipo').value = "Todos";
                                document.getElementById('filtroPrecio').value = "Todos";
                                document.getElementById('filtroCombustible').value = "Todos";
                                aplicarFiltrosGlobales();
                            });

                            [1, 2].forEach(col => {
                                document.getElementById(`marca${col}`).addEventListener('change', () => updateModelos(col));
                                document.getElementById(`modelo${col}`).addEventListener('change', () => updateVersiones(col));
                                document.getElementById(`version${col}`).addEventListener('change', () => displayAuto(col));
                            });

                            aplicarFiltrosGlobales();
                            document.getElementById('loader').classList.add('hidden');
                            document.getElementById('comparador-ui').classList.remove('hidden');
                        }
                    });
                } catch(e) { console.error(e); }
            }

            function aplicarFiltrosGlobales() {
                const tipo = document.getElementById('filtroTipo').value;
                const precio = document.getElementById('filtroPrecio').value;
                const comb = document.getElementById('filtroCombustible').value;

                bdAutos = bdAutosOriginal.filter(c => {
                    let pT = (tipo === "Todos" || c[columnaAA]?.trim() === tipo);
                    let pP = true;
                    if(precio !== "Todos") {
                        let v = parseInt(c['Precio (US$)']?.replace(/\D/g, ''));
                        pP = !isNaN(v) && v <= parseInt(precio);
                    }
                    let pC = true;
                    if(comb !== "Todos") {
                        let vL = (c['Combustible'] || "").toLowerCase();
                        let clas = vL.includes('hibrid') || vL.includes('hev') ? "Hibridos" : (vL.includes('electric') || vL.includes('ev') ? "Electrico" : "Tradicional");
                        pC = (clas === comb);
                    }
                    return pT && pP && pC;
                });

                arbolFiltros = {};
                bdAutos.forEach(c => {
                    const m = c['Marca'].trim(), mod = c['Modelo'] || "", ver = c['Versión'] || "Única";
                    if(!arbolFiltros[m]) arbolFiltros[m] = {};
                    if(mod && !arbolFiltros[m][mod]) arbolFiltros[m][mod] = [];
                    if(mod && !arbolFiltros[m][mod].includes(ver)) arbolFiltros[m][mod].push(ver);
                });

                [1, 2].forEach(col => {
                    const sM = document.getElementById(`marca${col}`);
                    sM.innerHTML = '<option value="">Seleccionar Marca</option>';
                    Object.keys(arbolFiltros).sort().forEach(m => sM.add(new Option(m, m)));
                    document.getElementById(`modelo${col}`).innerHTML = '<option value="">Modelo</option>';
                    document.getElementById(`version${col}`).innerHTML = '<option value="">Versión</option>';
                    document.getElementById(`resultado${col}`).classList.add('hidden');
                });
                document.getElementById('veredicto-box').classList.add('hidden');
            }

            function updateModelos(col) {
                const m = document.getElementById(`marca${col}`).value;
                const sMod = document.getElementById(`modelo${col}`);
                sMod.innerHTML = '<option value="">Modelo</option>';
                if(m && arbolFiltros[m]) {
                    Object.keys(arbolFiltros[m]).sort().forEach(mod => sMod.add(new Option(mod, mod)));
                    sMod.disabled = false;
                } else sMod.disabled = true;
            }

            function updateVersiones(col) {
                const m = document.getElementById(`marca${col}`).value;
                const mod = document.getElementById(`modelo${col}`).value;
                const sVer = document.getElementById(`version${col}`);
                sVer.innerHTML = '<option value="">Versión</option>';
                if(mod && arbolFiltros[m][mod]) {
                    arbolFiltros[m][mod].sort().forEach(v => sVer.add(new Option(v, v)));
                    sVer.disabled = false;
                } else sVer.disabled = true;
            }

            function displayAuto(col) {
                const m = document.getElementById(`marca${col}`).value, mod = document.getElementById(`modelo${col}`).value, ver = document.getElementById(`version${col}`).value;
                const auto = bdAutos.find(a => a['Marca'].trim() === m && a['Modelo'].trim() === mod && (a['Versión'] || "Única").trim() === ver);
                if(auto) {
                    if(col===1) autoA = auto; else autoB = auto;
                    document.getElementById(`nombre${col}`).innerText = `${m} ${mod} ${ver !== 'Única' ? ver : ''}`;
                    document.getElementById(`img${col}`).src = auto['URL de Imagen'] || '';
                    let v = parseInt(auto['Precio (US$)']?.replace(/\D/g, ''));
                    document.getElementById(`precio${col}`).innerText = isNaN(v) ? 'Consultar' : "US$ " + v.toLocaleString('es-ES');
                    document.getElementById(`mecanica${col}`).innerText = `${auto['Combustible']} | ${auto['Transmisión (MT / AT / CVT y N° de marchas)']}`;
                    document.getElementById(`seguridad${col}`).innerText = auto['ADAS (Full, Intermedio, Sin ADAS)'];
                    document.getElementById(`origenGarantia${col}`).innerText = auto['Garantía'];
                    
                    const cta = document.getElementById(`cta${col}`);
                    cta.href = `https://wa.me/595991244469?text=${encodeURIComponent('Hola Datacar, me interesa el ' + m + ' ' + mod + ' ' + ver)}`;
                    
                    document.getElementById(`resultado${col}`).classList.remove('hidden');
                    if(autoA && autoB) document.getElementById('veredicto-box').classList.remove('hidden');
                }
            }

            iniciarComparador();
        </script>
	</body>
</html>

                <div id="comparador-ui" class="hidden">
                    <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm mb-10">
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 items-end">
                            <div>

        <a href="https://wa.me/595991244469" target="_blank" class="fixed bottom-6 right-6 z-50 bg-[#25D366] text-white p-5 rounded-full shadow-2xl hover:scale-110 transition-transform">
            <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </a>

        <script type="module" is:inline>
            import Papa from 'https://cdn.jsdelivr.net/npm/papaparse@5.4.1/+esm';

            const URL_CSV = "https://docs.google.com/spreadsheets/d/e/2PACX-1vQgA9AGiaH-RdEQrO2mOSjNDe7_zPoBMZyp-Yzmc0IKkTo9CluAzhWRJ9JXT-4XgNAAgiF-Uzzsea5m/pub?output=csv";
            const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyTBqtK9wDzl10vc226zFwn4f-v-DVjKCfo9JVj3XCcepIcw41NQHchLrbDK6mz1zWgWg/exec';

            let bdOriginal = [];
            let bdFiltrada = [];
            let colMap = {};

            // 1. Formulario
            document.getElementById('lead-form')?.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('submit-btn');
                btn.disabled = true; btn.innerText = "ENVIANDO...";
                try {
                    await fetch(SCRIPT_URL, { method: 'POST', body: new FormData(e.target) });
                    window.location.href = '/gracias';
                } catch {
                    alert("Error. Intentá por WhatsApp.");
                    btn.disabled = false; btn.innerText = "ACTIVAR BÚSQUEDA";
                }
            });

            // 2. Motor de Comparación
            async function init() {
                try {
                    const res = await fetch(URL_CSV, { cache: "no-store" });
                    const text = await res.text();
                    Papa.parse(text, {
                        header: true, skipEmptyLines: true, transformHeader: h => h.trim(),
                        complete: (results) => {
                            bdOriginal = results.data.filter(r => r.Marca && r.Marca.trim() !== "");
                            const fields = results.meta.fields;
                            const f = (kws) => fields.find(f => kws.some(k => f.toLowerCase().includes(k.toLowerCase()))) || "";
                            
                            colMap = {
                                cat: fields[26],
                                precio: f(['precio']),
                                motor: f(['motor (cilindrada']),
                                trans: f(['transmisión']),
                                largo: f(['largo (mm)']),
                                baul: f(['baulera']),
                                plazas: f(['plazas']),
                                adas: f(['adas', 'seguridad']),
                                camara: f(['cámara']),
                                pantalla: f(['pantalla']),
                                conect: f(['conectividad']),
                                garantia: f(['garantía'])
                            };

                            poblarCategorias();
                            asignarEventos();
                            aplicarFiltros();
                            document.getElementById('loader').classList.add('hidden');
                            document.getElementById('comparador-ui').classList.remove('hidden');
                        }
                    });
                } catch(e) { console.error(e); }
            }

            function poblarCategorias() {
                const tipos = [...new Set(bdOriginal.map(c => c[colMap.cat]?.trim()).filter(Boolean))].sort();
                const select = document.getElementById('filtroTipo');
                const grupos = { 'SUV': [], 'Pick-up': [], 'Sedán': [], 'Hatchback': [], 'Otros': [] };
                tipos.forEach(t => {
                    const tl = t.toLowerCase();
                    if(tl.includes('suv')) grupos.SUV.push(t);
                    else if(tl.includes('pick')) grupos['Pick-up'].push(t);
                    else if(tl.includes('sed')) grupos.Sedán.push(t);
                    else if(tl.includes('hatch')) grupos.Hatchback.push(t);
                    else grupos.Otros.push(t);
                });
                select.innerHTML = '<option value="Todos">Todas las categorías</option>';
                for(const [g, items] of Object.entries(grupos)) {
                    if(items.length) {
                        const og = document.createElement('optgroup'); og.label = g;
                        items.forEach(i => og.appendChild(new Option(i, i)));
                        select.appendChild(og);
                    }
                }
            }

            function asignarEventos() {
                ['filtroTipo', 'filtroCombustible', 'filtroPrecio'].forEach(id => {
                    document.getElementById(id).addEventListener('change', aplicarFiltros);
                });
                document.getElementById('btnLimpiar').onclick = () => {
                    document.getElementById('filtroTipo').value = 'Todos';
                    document.getElementById('filtroCombustible').value = 'Todos';
                    document.getElementById('filtroPrecio').value = 'Todos';
                    aplicarFiltros();
                };
                [1, 2].forEach(col => {
                    document.getElementById(`marca${col}`).onchange = () => updateModelos(col);
                    document.getElementById(`modelo${col}`).onchange = () => updateVersiones(col);
                    document.getElementById(`version${col}`).onchange = () => mostrarAuto(col);
                });
            }

            function aplicarFiltros() {
                const fT = document.getElementById('filtroTipo').value;
                const fC = document.getElementById('filtroCombustible').value;
                const fP = document.getElementById('filtroPrecio').value;

                bdFiltrada = bdOriginal.filter(c => {
                    const pT = fT === 'Todos' || c[colMap.cat]?.trim() === fT;
                    const vP = parseInt(c[colMap.precio]?.replace(/\D/g, '')) || 0;
                    const pP = fP === 'Todos' || vP <= parseInt(fP);
                    const vL = (c.Combustible || "").toLowerCase();
                    const cat = vL.includes('hibrid') || vL.includes('hev') ? 'Hibridos' : (vL.includes('elect') || vL.includes('ev') ? 'Electrico' : 'Tradicional');
                    const pC = fC === 'Todos' || cat === fC;
                    return pT && pP && pC;
                });

                const arbol = {};
                bdFiltrada.forEach(c => {
                    const m = c.Marca.trim(), mo = (c.Modelo||"").trim(), v = (c.Versión||"Única").trim();
                    if(!arbol[m]) arbol[m] = {};
                    if(mo && !arbol[m][mo]) arbol[m][mo] = [];
                    if(mo && !arbol[m][mo].includes(v)) arbol[m][mo].push(v);
                });

                [1, 2].forEach(n => {
                    const s = document.getElementById(`marca${n}`);
                    s.innerHTML = '<option value="">Marca</option>';
                    Object.keys(arbol).sort().forEach(m => s.add(new Option(m, m)));
                    document.getElementById(`modelo${n}`).innerHTML = '<option value="">Modelo</option>';
                    document.getElementById(`modelo${n}`).disabled = true;
                    document.getElementById(`version${n}`).innerHTML = '<option value="">Versión</option>';
                    document.getElementById(`version${n}`).disabled = true;
                    document.getElementById(`resultado${n}`).classList.add('hidden');
                });
            }

            function updateModelos(n) {
                const m = document.getElementById(`marca${n}`).value;
                const s = document.getElementById(`modelo${n}`);
                s.innerHTML = '<option value="">Modelo</option>';
                if(m) {
                    const mods = [...new Set(bdFiltrada.filter(c => c.Marca.trim() === m).map(c => (c.Modelo||"").trim()))].sort();
                    mods.forEach(mo => s.add(new Option(mo, mo)));
                    s.disabled = false;
                } else s.disabled = true;
            }

            function updateVersiones(n) {
                const m = document.getElementById(`marca${n}`).value;
                const mo = document.getElementById(`modelo${n}`).value;
                const s = document.getElementById(`version${n}`);
                s.innerHTML = '<option value="">Versión</option>';
                if(mo) {
                    const vers = [...new Set(bdFiltrada.filter(c => c.Marca.trim() === m && (c.Modelo||"").trim() === mo).map(c => (c.Versión || "Única").trim()))].sort();
                    vers.forEach(v => s.add(new Option(v, v)));
                    s.disabled = false;
                } else s.disabled = true;
            }

            function mostrarAuto(n) {
                const m = document.getElementById(`marca${n}`).value;
                const mo = document.getElementById(`modelo${n}`).value;
                const v = document.getElementById(`version${n}`).value;
                const car = bdFiltrada.find(c => c.Marca.trim() === m && (c.Modelo||"").trim() === mo && (c.Versión || "Única").trim() === v);
                
                if(car) {
                    const specs = document.getElementById(`specs${n}`);
                    document.getElementById(`nombre${n}`).innerText = `${m} ${mo} ${v !== 'Única' ? v : ''}`;
                    document.getElementById(`img${n}`).src = car['URL de Imagen'] || '';
                    
                    const adas = car[colMap.adas]?.trim();

                    specs.innerHTML = `
                        <div class="spec-card-row highlight-price">
                            <span class="spec-header-label">Precio Final Negociable</span>
                            <span class="spec-data-value">${car[colMap.precio] || 'Consultar'}</span>
                        </div>
                        <div class="spec-card-row">
                            <span class="spec-header-label">Mecánica & Transmisión</span>
                            <span class="spec-data-value">${car.Combustible} | ${car[colMap.motor]} | ${car[colMap.trans]}</span>
                        </div>
                        <div class="spec-card-row">
                            <span class="spec-header-label">Dimensiones & Espacio</span>
                            <span class="spec-data-value">Largo: ${car[colMap.largo]}mm | Baúl: ${car[colMap.baul]}L | Plazas: ${car[colMap.plazas]}</span>
                        </div>
                        <div class="spec-card-row">
                            <span class="spec-header-label">Seguridad Avanzada</span>
                            <span class="spec-data-value ${!adas ? 'text-red-500' : ''}">${adas || 'Consultar ADAS con asesor'} | Cámaras: ${car[colMap.camara]}</span>
                        </div>
                        <div class="spec-card-row">
                            <span class="spec-header-label">Infotenimiento</span>
                            <span class="spec-data-value">${car[colMap.pantalla]} | ${car[colMap.conect]}</span>
                        </div>
                        <div class="spec-card-row" style="border:none; background:transparent;">
                            <span class="spec-header-label">Garantía Oficial</span>
                            <span class="spec-data-value text-slate-400 font-medium">${car[colMap.garantia] || 'Consultar'}</span>
                        </div>
                    `;

                    document.getElementById(`cta${n}`).href = `https://wa.me/595991244469?text=${encodeURIComponent('Hola Datacar, me interesa el ' + m + ' ' + mo + ' ' + v)}`;
                    document.getElementById(`resultado${n}`).classList.remove('hidden');
                }
            }

            init();
        </script>
	</body>
</html>

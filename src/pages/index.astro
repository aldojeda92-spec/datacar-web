                                </div>
                            </div>
                            <div id="resultado1" class="hidden p-8">
                                <img id="img1" src="" class="h-40 w-full object-contain mb-6" />
                                <h4 id="nombre1" class="text-xl font-black mb-4"></h4>
                                <div class="data-row"><span class="data-label">Precio</span><span id="precio1" class="data-value text-[#00BFFF] font-black text-xl"></span></div>
                                <div class="data-row"><span class="data-label">Motor</span><span id="mecanica1" class="data-value"></span></div>
                                <div class="data-row border-none"><span class="data-label">Garantía</span><span id="garantia1" class="data-value"></span></div>
                                <a id="cta1" href="#" target="_blank" class="block w-full bg-[#0A1F33] text-white text-center py-4 rounded-xl mt-6 font-bold uppercase text-xs">Elegir este Auto</a>
                            </div>
                        </div>
                        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
                            <div class="bg-gray-50 p-6 border-b">
                                <div class="space-y-3">
                                    <select id="marca2" class="w-full border p-3 rounded-xl font-bold"><option value="">Marca</option></select>
                                    <select id="modelo2" disabled class="w-full border p-3 rounded-xl"><option value="">Modelo</option></select>
                                    <select id="version2" disabled class="w-full border p-3 rounded-xl"><option value="">Versión</option></select>
                                </div>
                            </div>
                            <div id="resultado2" class="hidden p-8">
                                <img id="img2" src="" class="h-40 w-full object-contain mb-6" />
                                <h4 id="nombre2" class="text-xl font-black mb-4"></h4>
                                <div class="data-row"><span class="data-label">Precio</span><span id="precio2" class="data-value text-[#00BFFF] font-black text-xl"></span></div>
                                <div class="data-row"><span class="data-label">Motor</span><span id="mecanica2" class="data-value"></span></div>
                                <div class="data-row border-none"><span class="data-label">Garantía</span><span id="garantia2" class="data-value"></span></div>
                                <a id="cta2" href="#" target="_blank" class="block w-full bg-[#0A1F33] text-white text-center py-4 rounded-xl mt-6 font-bold uppercase text-xs">Elegir este Auto</a>
                            </div>
                        </div>
                    </div>
                    
                    <div id="veredicto-box" class="hidden mt-10 bg-[#0A1F33] p-8 rounded-3xl text-white text-center border-t-4 border-[#00BFFF]">
                        <p id="veredicto-texto" class="text-xl font-light italic"></p>
                    </div>
                </div>
            </div>
        </section>

        <section id="contacto" class="py-24 bg-[#0A1F33]">
            <div class="max-w-xl mx-auto px-4">
                <div class="bg-white rounded-3xl p-8 shadow-2xl">
                    <h3 class="text-2xl font-black text-center mb-6 text-[#0A1F33]">¿LO BUSCAMOS POR VOS?</h3>
                    <form id="lead-form" class="space-y-4">
                        <input type="text" name="nombre" required placeholder="Nombre Completo" class="w-full border p-4 rounded-xl outline-none focus:ring-2 focus:ring-[#00BFFF]">
                        <input type="tel" name="whatsapp" required placeholder="WhatsApp" class="w-full border p-4 rounded-xl outline-none focus:ring-2 focus:ring-[#00BFFF]">
                        <select name="interes" class="w-full border p-4 rounded-xl outline-none">

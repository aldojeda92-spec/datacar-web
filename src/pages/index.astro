                                <h4 id="nombre2" class="text-3xl font-black text-[#0A1F33] mb-8 leading-tight"></h4>
                                
                                <div class="data-row"><span class="data-label">Precio</span><span id="precio2" class="data-value text-[#00BFFF] font-black text-2xl"></span></div>
                                <div class="data-row"><span class="data-label">Mecánica</span><span id="mec2" class="data-value text-xs"></span></div>
                                <div class="data-row"><span class="data-label">Capacidades (Baúl/Asientos)</span><span id="cap2" class="data-value"></span></div>
                                <div class="data-row"><span class="data-label">Seguridad (ADAS/Cámaras)</span><span id="seg2" class="data-value"></span></div>
                                <div class="data-row"><span class="data-label">Tecnología (Pantalla)</span><span id="tec2" class="data-value"></span></div>
                                <div class="data-row border-none"><span class="data-label">Garantía Oficial</span><span id="gar2" class="data-value"></span></div>

                                <a id="cta2" href="#" target="_blank" class="block w-full bg-[#0A1F33] text-white text-center py-5 rounded-2xl mt-10 font-black uppercase text-sm tracking-widest shadow-lg hover:bg-[#1a3a5a] transition">Elegir este auto</a>

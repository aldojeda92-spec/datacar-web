        <section id="contacto" class="py-24 bg-[#0A1F33] text-white relative overflow-hidden">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
                <h2 class="text-3xl md:text-5xl font-[900] mb-6" style="font-family: 'Montserrat', sans-serif;">¿Listo para comprar inteligente?</h2>
                <div class="bg-white rounded-3xl p-2 md:p-4 max-w-2xl mx-auto shadow-2xl overflow-hidden min-h-[500px]">
                    <div data-tf-live="01KK22DB3E8S91PJ7GF28ZH3P2"></div>
                    <script is:inline src="//embed.typeform.com/next/embed.js"></script>
                </div>
            </div>
        </section>

    <footer class="bg-[#05111D] text-gray-500 py-16 text-center border-t border-[#1A3A5C]">
        <div class="flex items-center justify-center mb-6" style="font-family: 'Montserrat', sans-serif;">
            <span class="text-2xl font-[900] text-white leading-none opacity-70 hover:opacity-100 transition">DATA</span>
            <span class="text-2xl font-[300] text-[#C0C0C0] leading-none tracking-[1px] opacity-70 hover:opacity-100 transition">CAR</span>
        </div>
        <p class="font-light text-sm mb-6" style="font-family: 'Inter', sans-serif;">Gestión de inversiones automotrices</p>
        <p class="text-xs opacity-40" style="font-family: 'Inter', sans-serif;">© 2024 DATACAR EAS.</p>
    </footer>

        <script is:inline>
            const URL_CSV = "https://docs.google.com/spreadsheets/d/e/2PACX-1vQgA9AGiaH-RdEQrO2mOSjNDe7_zPoBMZyp-Yzmc0IKkTo9CluAzhWRJ9JXT-4XgNAAgiF-Uzzsea5m/pub?output=csv";
            
            let bdAutosOriginal = []; // Base de datos intocable
            let bdAutos = []; // Base de datos que se recorta con los filtros
            let arbolFiltros = {}; 
            let autoA = null;
            let autoB = null;

            document.addEventListener('DOMContentLoaded', () => {
                const loader = document.getElementById('loader');
                const ui = document.getElementById('comparador-ui');

                Papa.parse(URL_CSV, {
                    download: true,
                    header: true,
                    skipEmptyLines: true,
                    complete: function(results) {
                        try {
                            // Limpiamos los vacíos desde el principio
                            bdAutosOriginal = results.data.filter(car => car['Marca'] && car['Marca'].trim() !== "");
                            if (bdAutosOriginal.length === 0) throw new Error("Excel vacío");

                            // Cargamos el filtro dinámico de carrocería leyendo el excel
                            cargarFiltroCarroceria();
                            
                            // Aplicamos los filtros globales por primera vez (mostrará todo)
                            aplicarFiltrosGlobales();
                            
                            loader.classList.add('hidden');
                            ui.classList.remove('hidden');
                        } catch (error) {
                            console.error(error);
                            document.getElementById('loader-text').innerHTML = "⚠️ Error leyendo datos.";
                        }
                    }
                });
            });

            function cargarFiltroCarroceria() {
                const tipos = [...new Set(bdAutosOriginal.map(c => c['Tipo Carrocería'] ? c['Tipo Carrocería'].trim() : null).filter(Boolean))].sort();
                const select = document.getElementById('filtroTipo');
                tipos.forEach(t => select.add(new Option(t, t)));
            }

            function aplicarFiltrosGlobales() {
                const tipoSel = document.getElementById('filtroTipo').value;
                const precioMax = document.getElementById('filtroPrecio').value;

                // Filtramos la base original hacia la base de uso
                bdAutos = bdAutosOriginal.filter(car => {
                    let pasaTipo = (tipoSel === "Todos" || (car['Tipo Carrocería'] && car['Tipo Carrocería'].trim() === tipoSel));
                    let pasaPrecio = true;

                    if (precioMax !== "Todos") {
                        const pValue = car['Precio (US$)'] ? parseInt(car['Precio (US$)'].replace(/\D/g, '')) : NaN;
                        if (!isNaN(pValue)) {
                            pasaPrecio = pValue <= parseInt(precioMax);
                        } else {
                            // Si no tiene precio numérico, lo ocultamos si el cliente puso un límite de plata
                            pasaPrecio = false; 
                        }
                    }
                    return pasaTipo && pasaPrecio;
                });

                // Re-generamos la cascada solo con los autos que sobrevivieron al filtro
                generarEstructuraFiltros();
                cargarMarcas();
                resetComparadorResultados();
            }

            function resetearFiltros() {
                document.getElementById('filtroTipo').value = "Todos";
                document.getElementById('filtroPrecio').value = "Todos";
                aplicarFiltrosGlobales();
            }

            function resetComparadorResultados() {
                [1, 2].forEach(col => {
                    document.getElementById(`modelo${col}`).innerHTML = '<option value="">Modelo</option>';
                    document.getElementById(`version${col}`).innerHTML = '<option value="">Versión</option>';
                    document.getElementById(`modelo${col}`).disabled = true;
                    document.getElementById(`version${col}`).disabled = true;
                    document.getElementById(`resultado${col}`).classList.add('hidden');
                });
                document.getElementById('veredicto-box').classList.add('hidden');
                autoA = null;
                autoB = null;
            }

            function generarEstructuraFiltros() {
                arbolFiltros = {}; // Vaciamos para recalcular
                bdAutos.forEach(car => {
                    const m = car['Marca'].trim();
                    const mod = car['Modelo'] ? car['Modelo'].trim() : "";
                    const ver = car['Versión'] ? car['Versión'].trim() : "Única";

                    if (!arbolFiltros[m]) arbolFiltros[m] = {};
                    if (mod && !arbolFiltros[m][mod]) arbolFiltros[m][mod] = [];
                    if (mod && !arbolFiltros[m][mod].includes(ver)) arbolFiltros[m][mod].push(ver);
                });
            }

            function cargarMarcas() {
                const marcas = Object.keys(arbolFiltros).sort();
                const selects = [document.getElementById('marca1'), document.getElementById('marca2')];
                selects.forEach(s => {
                    s.innerHTML = '<option value="">Seleccionar Marca</option>';
                    marcas.forEach(m => s.add(new Option(m, m)));
                });
            }

            function updateModelos(col) {
                const marca = document.getElementById(`marca${col}`).value;
                const selectMod = document.getElementById(`modelo${col}`);
                const selectVer = document.getElementById(`version${col}`);
                
                selectMod.innerHTML = '<option value="">Modelo</option>';
                selectVer.innerHTML = '<option value="">Versión</option>';
                selectMod.disabled = true;
                selectVer.disabled = true;
                document.getElementById(`resultado${col}`).classList.add('hidden');
                document.getElementById('veredicto-box').classList.add('hidden');

                if (marca && arbolFiltros[marca]) {
                    const modelos = Object.keys(arbolFiltros[marca]).sort();
                    modelos.forEach(mod => selectMod.add(new Option(mod, mod)));
                    selectMod.disabled = false;
                }
            }

            function updateVersiones(col) {
                const marca = document.getElementById(`marca${col}`).value;
                const modelo = document.getElementById(`modelo${col}`).value;
                const selectVer = document.getElementById(`version${col}`);
                
                selectVer.innerHTML = '<option value="">Versión</option>';
                selectVer.disabled = true;
                document.getElementById(`resultado${col}`).classList.add('hidden');
                document.getElementById('veredicto-box').classList.add('hidden');

                if (modelo && arbolFiltros[marca][modelo]) {
                    const versiones = arbolFiltros[marca][modelo].sort();
                    versiones.forEach(v => selectVer.add(new Option(v, v)));
                    selectVer.disabled = false;
                }
            }

            function displayAuto(col) {
                const m = document.getElementById(`marca${col}`).value;
                const mod = document.getElementById(`modelo${col}`).value;
                const ver = document.getElementById(`version${col}`).value;
                
                const auto = bdAutos.find(a => a['Marca'].trim() === m && a['Modelo'].trim() === mod && (a['Versión'] || "Única").trim() === ver);
                
                if (auto) {
                    if(col === 1) autoA = auto; else autoB = auto;

                    document.getElementById(`nombre${col}`).innerText = `${m} ${mod} ${ver !== 'Única' ? ver : ''}`;
                    document.getElementById(`img${col}`).src = auto['URL de Imagen'] || '';
                    
                    const pValue = auto['Precio (US$)'] ? parseInt(auto['Precio (US$)'].replace(/\D/g, '')) : NaN;
                    document.getElementById(`precio${col}`).innerText = isNaN(pValue) ? (auto['Precio (US$)'] || 'Consultar') : "US$ " + pValue.toLocaleString('es-ES');
                    
                    document.getElementById(`mecanica${col}`).innerText = `${auto['Combustible'] || '-'} | Motor: ${auto['Motor (Cilindrada / HP / Torque)'] || '-'} | Caja: ${auto['Transmisión (MT / AT / CVT y N° de marchas)'] || '-'} | Tracción: ${auto['Tracción'] || '-'}`;
                    document.getElementById(`medidas${col}`).innerText = `L: ${auto['Largo (mm)']}mm | A: ${auto['Ancho (mm)']}mm | Alt: ${auto['Alto (mm)']}mm | Despeje: ${auto['Despeje del suelo (mm)']}mm | Baúl: ${auto['Baulera (Litros)']}L | Plazas: ${auto['Plazas (Asientos) (Nuevo)']}`;
                    document.getElementById(`seguridad${col}`).innerText = `ADAS: ${auto['ADAS (Full, Intermedio, Sin ADAS)'] || '-'} | Cámaras: ${auto['Cámaras (Retroceso / 360)'] || '-'}`;
                    document.getElementById(`info${col}`).innerText = `Pantalla: ${auto['Tamaño Pantalla (Pulgadas)']} | ${auto['Conectividad (Inalámbrico/Cable)']}`;
                    document.getElementById(`confort${col}`).innerText = `Asientos de cuero: ${auto['Asientos de Cuero (Sí/No)']} | Techo: ${auto['Techo Panorámico/Corredizo (Sí/No)']}`;
                    document.getElementById(`origenGarantia${col}`).innerText = `Fabricado en: ${auto['Origen'] || '-'} | Garantía: ${auto['Garantía'] || '-'}`;

                    const msg = encodeURIComponent(`¡Hola Datacar! Estuve comparando en la web y me interesa comprar el ${m} ${mod} ${ver}. ¿Me asesoran?`);
                    document.getElementById(`cta${col}`).href = `https://wa.me/595991244469?text=${msg}`;

                    document.getElementById(`resultado${col}`).classList.remove('hidden');
                    calcularVeredicto();
                }
            }

            function calcularVeredicto() {
                if(autoA && autoB) {
                    const box = document.getElementById('veredicto-box');
                    const txt = document.getElementById('veredicto-texto');
                    
                    const pA = autoA['Precio (US$)'] ? parseInt(autoA['Precio (US$)'].replace(/\D/g, '')) : NaN;
                    const pB = autoB['Precio (US$)'] ? parseInt(autoB['Precio (US$)'].replace(/\D/g, '')) : NaN;

                    if(!isNaN(pA) && !isNaN(pB)) {
                        if(pA < pB) {
                            txt.innerHTML = `El <strong>${autoA['Marca']} ${autoA['Modelo']}</strong> representa un ahorro inicial de <strong>US$ ${(pB - pA).toLocaleString('es-ES')}</strong>. Analizá si la diferencia de equipamiento y origen justifica el salto de valor hacia el ${autoB['Marca']}.`;
                        } else if(pB < pA) {
                            txt.innerHTML = `El <strong>${autoB['Marca']} ${autoB['Modelo']}</strong> representa un ahorro inicial de <strong>US$ ${(pA - pB).toLocaleString('es-ES')}</strong>. Analizá si la diferencia de equipamiento y origen justifica el salto de valor hacia el ${autoA['Marca']}.`;
                        } else {
                            txt.innerHTML = `Ambas unidades cuestan exactamente lo mismo (US$ ${pA.toLocaleString('es-ES')}). La decisión es 100% técnica: compará la seguridad ADAS, la mecánica y el confort interior.`;
                        }
                    } else {
                        txt.innerHTML = `Comparativa técnica lista. Contactá a nuestro equipo para obtener las cotizaciones formales y comparar los costos de mantenimiento de ambos modelos.`;
                    }
                    box.classList.remove('hidden');
                }
            }
        </script>
	</body>
</html>

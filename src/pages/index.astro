        <script type="module" is:inline>
            import Papa from 'https://cdn.jsdelivr.net/npm/papaparse@5.4.1/+esm';

            const URL_CSV = "https://docs.google.com/spreadsheets/d/e/2PACX-1vQgA9AGiaH-RdEQrO2mOSjNDe7_zPoBMZyp-Yzmc0IKkTo9CluAzhWRJ9JXT-4XgNAAgiF-Uzzsea5m/pub?output=csv";
            
            let bdAutosOriginal = []; 
            let bdAutos = []; 
            let arbolFiltros = {}; 
            let autoA = null;
            let autoB = null;
            let columnaAA = 'Tipo Carrocería'; // Valor por defecto

            const loaderText = document.getElementById('loader-text');
            const loader = document.getElementById('loader');
            const ui = document.getElementById('comparador-ui');

            function showError(msg) {
                if(loaderText) {
                    loaderText.innerHTML = msg;
                    loaderText.classList.replace("text-[#0A1F33]", "text-red-600");
                }
                if(loader) {
                    const spin = loader.querySelector('.animate-spin');
                    if(spin) spin.style.display = 'none';
                }
            }

            async function iniciarComparador() {
                try {
                    const res = await fetch(URL_CSV, { cache: "no-store" });
                    if (!res.ok) throw new Error("Acceso a Google Sheets denegado.");
                    
                    const csvText = await res.text();
                    if(loaderText) loaderText.innerText = "Procesando vehículos...";

                    Papa.parse(csvText, {
                        header: true,
                        skipEmptyLines: true,
                        transformHeader: h => h.trim(),
                        complete: function(results) {
                            bdAutosOriginal = results.data.filter(c => c['Marca'] && c['Marca'].trim() !== "");
                            
                            if (bdAutosOriginal.length === 0) {
                                showError("⚠️ No se detectó la columna 'Marca'.");
                                return;
                            }

                            // DETECTA AUTOMÁTICAMENTE EL NOMBRE DE LA COLUMNA AA (La nro 26)
                            const headers = results.meta.fields;
                            if (headers.length > 26) {
                                columnaAA = headers[26]; 
                            }

                            // Cargar Select de Tipos leyendo específicamente la Columna AA
                            const tipos = [...new Set(bdAutosOriginal.map(c => c[columnaAA] ? c[columnaAA].trim() : null).filter(Boolean))].sort();
                            const selectTipo = document.getElementById('filtroTipo');
                            tipos.forEach(t => selectTipo.add(new Option(t, t)));

                            // Asignar Eventos de los filtros
                            document.getElementById('filtroTipo').addEventListener('change', aplicarFiltrosGlobales);
                            document.getElementById('filtroPrecio').addEventListener('change', aplicarFiltrosGlobales);
                            document.getElementById('filtroCombustible').addEventListener('change', aplicarFiltrosGlobales);
                            document.getElementById('btnLimpiar').addEventListener('click', resetearFiltros);
                            
                            document.getElementById('marca1').addEventListener('change', () => updateModelos(1));
                            document.getElementById('modelo1').addEventListener('change', () => updateVersiones(1));
                            document.getElementById('version1').addEventListener('change', () => displayAuto(1));
                            
                            document.getElementById('marca2').addEventListener('change', () => updateModelos(2));
                            document.getElementById('modelo2').addEventListener('change', () => updateVersiones(2));
                            document.getElementById('version2').addEventListener('change', () => displayAuto(2));

                            aplicarFiltrosGlobales();
                            
                            loader.classList.add('hidden');
                            ui.classList.remove('hidden');
                        }
                    });
                } catch(error) {
                    showError("⚠️ " + error.message);
                }
            }

            function aplicarFiltrosGlobales() {
                const tipo = document.getElementById('filtroTipo').value;
                const precio = document.getElementById('filtroPrecio').value;
                const comb = document.getElementById('filtroCombustible').value;

                bdAutos = bdAutosOriginal.filter(c => {
                    // Filtro 1: Carrocería (Usando la columna AA exacta)
                    let valorCarroceria = c[columnaAA] ? c[columnaAA].trim() : "";
                    let pasaTipo = (tipo === "Todos" || valorCarroceria === tipo);
                    
                    // Filtro 2: Precio
                    let pasaPrecio = true;
                    if(precio !== "Todos") {
                        let val = c['Precio (US$)'] ? parseInt(c['Precio (US$)'].replace(/\D/g, '')) : NaN;
                        pasaPrecio = !isNaN(val) && val <= parseInt(precio);
                    }

                    // Filtro 3: Inteligencia de Combustible
                    let pasaCombustible = true;
                    if(comb !== "Todos") {
                        let valorComb = c['Combustible'] || "";
                        let vLower = valorComb.toLowerCase();
                        let clasificacion = "Tradicional"; // Por defecto todo es combustión
                        
                        // Busca si es híbrido en cualquiera de sus formas
                        if(vLower.includes('hibrid') || vLower.includes('híbrid') || vLower.includes('hev') || vLower.includes('mhev') || vLower.includes('phev')) {
                            clasificacion = "Hibridos";
                        } 
                        // Busca si es 100% eléctrico
                        else if(vLower.includes('electric') || vLower.includes('eléctric') || vLower === 'ev' || vLower.includes(' ev') || vLower.includes('bev')) {
                            clasificacion = "Electrico";
                        }
                        
                        pasaCombustible = (clasificacion === comb);
                    }

                    return pasaTipo && pasaPrecio && pasaCombustible;
                });

                arbolFiltros = {};
                bdAutos.forEach(c => {
                    const m = c['Marca'].trim();
                    const mod = c['Modelo'] ? c['Modelo'].trim() : "";
                    const ver = c['Versión'] ? c['Versión'].trim() : "Única";
                    if(!arbolFiltros[m]) arbolFiltros[m] = {};
                    if(mod && !arbolFiltros[m][mod]) arbolFiltros[m][mod] = [];
                    if(mod && !arbolFiltros[m][mod].includes(ver)) arbolFiltros[m][mod].push(ver);
                });

                [1, 2].forEach(col => {
                    const sel = document.getElementById(`marca${col}`);
                    sel.innerHTML = '<option value="">Seleccionar Marca</option>';
                    Object.keys(arbolFiltros).sort().forEach(m => sel.add(new Option(m, m)));
                });
                resetearResultados();
            }

            function resetearFiltros() {
                document.getElementById('filtroTipo').value = "Todos";
                document.getElementById('filtroPrecio').value = "Todos";
                document.getElementById('filtroCombustible').value = "Todos";
                aplicarFiltrosGlobales();
            }

            function resetearResultados() {
                [1, 2].forEach(col => {
                    document.getElementById(`modelo${col}`).innerHTML = '<option value="">Modelo</option>';
                    document.getElementById(`modelo${col}`).disabled = true;
                    document.getElementById(`version${col}`).innerHTML = '<option value="">Versión</option>';
                    document.getElementById(`version${col}`).disabled = true;
                    document.getElementById(`resultado${col}`).classList.add('hidden');
                });
                document.getElementById('veredicto-box').classList.add('hidden');
                autoA = null; autoB = null;
            }

            function updateModelos(col) {
                const m = document.getElementById(`marca${col}`).value;
                const sMod = document.getElementById(`modelo${col}`);
                sMod.innerHTML = '<option value="">Modelo</option>';
                document.getElementById(`version${col}`).innerHTML = '<option value="">Versión</option>';
                document.getElementById(`version${col}`).disabled = true;
                document.getElementById(`resultado${col}`).classList.add('hidden');
                document.getElementById('veredicto-box').classList.add('hidden');

                if(m && arbolFiltros[m]) {
                    Object.keys(arbolFiltros[m]).sort().forEach(mod => sMod.add(new Option(mod, mod)));
                    sMod.disabled = false;
                } else {
                    sMod.disabled = true;
                }
            }

            function updateVersiones(col) {
                const m = document.getElementById(`marca${col}`).value;
                const mod = document.getElementById(`modelo${col}`).value;
                const sVer = document.getElementById(`version${col}`);
                sVer.innerHTML = '<option value="">Versión</option>';
                document.getElementById(`resultado${col}`).classList.add('hidden');
                document.getElementById('veredicto-box').classList.add('hidden');

                if(mod && arbolFiltros[m][mod]) {
                    arbolFiltros[m][mod].sort().forEach(v => sVer.add(new Option(v, v)));
                    sVer.disabled = false;
                } else {
                    sVer.disabled = true;
                }
            }

            function displayAuto(col) {
                const m = document.getElementById(`marca${col}`).value;
                const mod = document.getElementById(`modelo${col}`).value;
                const ver = document.getElementById(`version${col}`).value;
                
                const auto = bdAutos.find(a => a['Marca'].trim() === m && a['Modelo'].trim() === mod && (a['Versión'] || "Única").trim() === ver);
                
                if(auto) {
                    if(col===1) autoA = auto; else autoB = auto;
                    
                    document.getElementById(`nombre${col}`).innerText = `${m} ${mod} ${ver !== 'Única' ? ver : ''}`;
                    document.getElementById(`img${col}`).src = auto['URL de Imagen'] || '';
                    
                    let val = parseInt((auto['Precio (US$)']||"").replace(/\D/g, ''));
                    document.getElementById(`precio${col}`).innerText = isNaN(val) ? (auto['Precio (US$)'] || 'Consultar') : "US$ " + val.toLocaleString('es-ES');
                    
                    document.getElementById(`mecanica${col}`).innerText = `${auto['Combustible']||'-'} | Motor: ${auto['Motor (Cilindrada / HP / Torque)']||'-'} | Caja: ${auto['Transmisión (MT / AT / CVT y N° de marchas)']||'-'} | Tracción: ${auto['Tracción']||'-'}`;
                    document.getElementById(`medidas${col}`).innerText = `L: ${auto['Largo (mm)']}mm | A: ${auto['Ancho (mm)']}mm | Alt: ${auto['Alto (mm)']}mm | Despeje: ${auto['Despeje del suelo (mm)']}mm | Baúl: ${auto['Baulera (Litros)']}L | Plazas: ${auto['Plazas (Asientos) (Nuevo)']}`;
                    document.getElementById(`seguridad${col}`).innerText = `ADAS: ${auto['ADAS (Full, Intermedio, Sin ADAS)']||'-'} | Cámaras: ${auto['Cámaras (Retroceso / 360)']||'-'}`;
                    document.getElementById(`info${col}`).innerText = `Pantalla: ${auto['Tamaño Pantalla (Pulgadas)']} | ${auto['Conectividad (Inalámbrico/Cable)']}`;
                    document.getElementById(`confort${col}`).innerText = `Asientos cuero: ${auto['Asientos de Cuero (Sí/No)']} | Techo: ${auto['Techo Panorámico/Corredizo (Sí/No)']}`;
                    document.getElementById(`origenGarantia${col}`).innerText = `Origen: ${auto['Origen']||'-'} | Garantía: ${auto['Garantía']||'-'}`;

                    document.getElementById(`cta${col}`).href = `https://wa.me/595991244469?text=${encodeURIComponent('Hola Datacar, me interesa el ' + m + ' ' + mod + ' ' + ver)}`;
                    document.getElementById(`resultado${col}`).classList.remove('hidden');

                    if(autoA && autoB) {
                        let p1 = parseInt((autoA['Precio (US$)']||"").replace(/\D/g, ''));
                        let p2 = parseInt((autoB['Precio (US$)']||"").replace(/\D/g, ''));
                        let txt = document.getElementById('veredicto-texto');
                        if(!isNaN(p1) && !isNaN(p2)) {
                            if(p1 < p2) txt.innerHTML = `El <strong>${autoA['Marca']} ${autoA['Modelo']}</strong> representa un ahorro de <strong>US$ ${(p2-p1).toLocaleString('es-ES')}</strong>.`;
                            else if(p2 < p1) txt.innerHTML = `El <strong>${autoB['Marca']} ${autoB['Modelo']}</strong> representa un ahorro de <strong>US$ ${(p1-p2).toLocaleString('es-ES')}</strong>.`;
                            else txt.innerHTML = `Ambas unidades cuestan exactamente lo mismo. La decisión es 100% técnica.`;
                        } else {
                            txt.innerHTML = `Comparativa técnica lista. Contactá a nuestro equipo para cotizaciones.`;
                        }
                        document.getElementById('veredicto-box').classList.remove('hidden');
                    }
                }
            }

            // Ejecución segura
            iniciarComparador();
        </script>
	</body>
</html>

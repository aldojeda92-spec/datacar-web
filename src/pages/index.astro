                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-500 mb-2 uppercase">Presupuesto Máximo</label>
                                <select id="filtroPrecio" class="w-full bg-gray-50 border border-gray-300 text-[#0A1F33] text-sm rounded-xl p-3 font-bold outline-none">

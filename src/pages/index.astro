                                    <option value="15000">Hasta US$ 15.000</option>
                                    <option value="25000">Hasta US$ 25.000</option>
                                    <option value="35000">Hasta US$ 35.000</option>
                                    <option value="50000">Hasta US$ 50.000</option>
                                    <option value="80000">Hasta US$ 80.000</option>
                                </select>
                            </div>
                            <button id="btnLimpiar" class="text-[#00BFFF] font-bold underline text-sm pb-3">Limpiar filtros</button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
                            <div class="bg-gray-50 p-6 border-b">
                                <div class="space-y-3">
                                    <select id="marca1" class="w-full border p-3 rounded-xl font-bold"><option value="">Marca</option></select>
                                    <select id="modelo1" disabled class="w-full border p-3 rounded-xl"><option value="">Modelo</option></select>

---
// src/pages/veredicto.astro

// Datos simulados recibidos de la URL (Paso 1)
const nombreUsuario = Astro.url.searchParams.get('nombre') || "Juan Pérez";
const pMin = Astro.url.searchParams.get('min') || "15,000";
const pMax = Astro.url.searchParams.get('max') || "30,000";

// Fecha actual para el Dossier
const fechaActual = new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

// Datos del Veredicto (Basado estrictamente en tu PDF)
const veredicto = {
  ganador: {
    marca: "Nissan", modelo: "New Kicks", version: "Sense (2026)", precio: 23990,
    racional: [
      "ADAS Full de serie — 2 de 4 rivales no lo incluyen: asistencia de frenado, control de carril y crucero adaptativo.",
      "Marca Nissan con red de servicios establecida en Paraguay — respaldo postventa garantizado y repuestos disponibles.",
      "Mejor relación precio-equipamiento del grupo: $23,990 USD con las prestaciones más completas para el perfil."
    ]
  },
  podio: [
    { posicion: 1, marca: "Nissan", modelo: "New Kicks", version: "Sense (2026)", precio: 23990, etiqueta: "RECOMENDACIÓN" },
    { posicion: 2, marca: "Chevrolet", modelo: "Tracker", version: "LTZ (2026)", precio: 21500, etiqueta: "Alternativa #2" },
    { posicion: 3, marca: "Volkswagen", modelo: "Nivus", version: "HL", precio: 24500, etiqueta: "Alternativa #3" }
  ],
  descartados: [
    { marca: "Changan", modelo: "CS55 PLUS", razon: "Marca no consolidada en el mercado local frente a un perfil conservador..." },
    { marca: "Volkswagen", modelo: "T-Cross", razon: "Espacio de carga inferior: 373L vs 470L del ganador." }
  ],
  tabla: [
    { atributo: "Precio", nissan: "$23,990", chevrolet: "$21,500", vw_nivus: "$24,500", changan: "$22,700", vw_tcross: "$23,500" },
    { atributo: "Motor/HP", nissan: "1.6L 120hp", chevrolet: "1.2T 130hp", vw_nivus: "1.0 200 TSI 116hp", changan: "1.5T 185hp", vw_tcross: "1.0 200 TSI 116hp" },
    { atributo: "Transmisión", nissan: "Automática", chevrolet: "Automática", vw_nivus: "Automática", changan: "Automática", vw_tcross: "Automática" },
    { atributo: "Airbags", nissan: "6 airbags", chevrolet: "6 airbags", vw_nivus: "6 airbags", changan: "6 airbags", vw_tcross: "6 airbags" }
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DATACAR - Dossier de Inversión</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@300;900&display=swap" rel="stylesheet">
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body class="bg-[#F0F2F5] text-[#3A3A3C] font-inter pb-32">

  {/* NAVEGACIÓN SUPERIOR */}
  <header class="bg-[#0A1F33] py-4 px-8 flex justify-between items-center text-white no-print">
    <div class="font-montserrat font-black text-2xl tracking-tight">DATA<span class="font-light text-[#C0C0C0] tracking-[1px]">CAR</span></div>
    <div class="text-sm font-medium">Paso 3: Veredicto</div>
  </header>

  {/* CONTENEDOR DEL DOSSIER (Simula una hoja A4) */}
  <main class="max-w-4xl mx-auto mt-8">
    
    <div id="dossier-pdf-content" class="bg-white shadow-lg p-10 relative">
      
      {/* ENCABEZADO DEL DOSSIER (Como en el PDF) */}
      <div class="border-b-2 border-[#0A1F33] pb-6 mb-8 flex justify-between items-start">
        <div>
          <div class="font-montserrat font-black text-3xl text-[#0A1F33] tracking-tight mb-1">DATA<span class="font-light text-[#C0C0C0]">CAR</span></div>
          <div class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Asesoría Automotriz Independiente</div>
        </div>
        <div class="text-right">
          <h1 class="font-montserrat font-black text-[#0A1F33] text-xl uppercase">Dossier de Inversión</h1>
          <h2 class="font-montserrat font-medium text-gray-500 text-sm uppercase mb-4">Análisis Comparativo de Mercado</h2>
          
          <div class="grid grid-cols-2 gap-x-8 gap-y-1 text-xs text-left bg-gray-50 p-3 border border-gray-200">
            <div class="text-gray-500 uppercase text-[10px]">Cliente</div>
            <div class="font-bold text-[#0A1F33]">{nombreUsuario}</div>
            
            <div class="text-gray-500 uppercase text-[10px]">Categoría</div>
            <div class="font-bold text-[#0A1F33]">SUV Seguridad</div>
            
            <div class="text-gray-500 uppercase text-[10px]">Presupuesto</div>
            <div class="font-bold text-[#0A1F33]">${pMin} - ${pMax}</div>
            
            <div class="text-gray-500 uppercase text-[10px]">Fecha</div>
            <div class="font-bold text-[#0A1F33]">{fechaActual}</div>
          </div>
        </div>
      </div>

      {/* BLOQUE GANADOR */}
      <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Recomendación DATACAR</h3>
      <div class="border-2 border-[#0A1F33] p-6 mb-8 flex gap-6 relative bg-white">
        <div class="absolute -top-3 left-4 bg-[#0A1F33] text-white text-[10px] font-bold px-3 py-1 uppercase tracking-wider flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#00BFFF]"></span> Top Pick
        </div>
        
        <div class="w-1/3 bg-gray-100 flex items-center justify-center border border-gray-200 text-gray-400 text-xs uppercase">
          [Imagen]
        </div>
        
        <div class="w-2/3">
          <h2 class="font-montserrat font-black text-2xl text-[#0A1F33] leading-none mb-1">{veredicto.ganador.marca} {veredicto.ganador.modelo}</h2>
          <p class="text-sm text-gray-500 mb-4">{veredicto.ganador.version}</p>
          
          <ul class="space-y-3 text-xs text-[#3A3A3C]">
            {veredicto.ganador.racional.map(item => (
              <li class="flex items-start gap-2">
                <span class="text-[#00BFFF] font-bold mt-0.5">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* BARRIDO DE MERCADO / PODIO */}
      <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3 border-b border-gray-200 pb-2">El Barrido de Mercado: El Podio</h3>
      <div class="grid grid-cols-3 gap-4 mb-8">
        {veredicto.podio.map(auto => (
          <div class="border border-gray-200 bg-gray-50 p-4 flex flex-col">
            <div class={`text-[10px] font-bold uppercase mb-3 ${auto.posicion === 1 ? 'text-[#00BFFF]' : 'text-gray-500'}`}>
              {auto.etiqueta}
            </div>
            <h4 class="font-bold text-[#0A1F33] text-sm leading-tight">{auto.marca}<br/>{auto.modelo}</h4>
            <p class="text-[10px] text-gray-500 mb-2">{auto.version}</p>
            <p class="font-bold text-[#0A1F33] text-sm mt-auto">${auto.precio.toLocaleString()}</p>
          </div>
        ))}
      </div>

      {/* DESCARTADOS */}
      <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3 border-b border-gray-200 pb-2">Evaluados - No alcanzaron el podio</h3>
      <div class="space-y-3 mb-8">
        {veredicto.descartados.map(auto => (
          <div class="flex flex-col md:flex-row gap-2 md:items-center text-xs">
            <div class="w-1/3 font-bold text-[#3A3A3C]">{auto.marca} {auto.modelo}</div>
            <div class="w-2/3 text-gray-500 bg-gray-50 px-3 py-2 border-l-2 border-gray-300">{auto.razon}</div>
          </div>
        ))}
      </div>

      {/* TABLA COMPARATIVA */}
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-[#0A1F33] text-white">
              <th class="p-3 font-bold uppercase tracking-wider w-1/6">Atributo</th>
              <th class="p-3 font-bold uppercase border-l border-gray-600 bg-[#00BFFF]">Nissan Kicks</th>
              <th class="p-3 font-bold uppercase border-l border-gray-600">Chevy Tracker</th>
              <th class="p-3 font-bold uppercase border-l border-gray-600">VW Nivus</th>
              <th class="p-3 font-bold uppercase border-l border-gray-600">Changan CS55</th>
              <th class="p-3 font-bold uppercase border-l border-gray-600">VW T-Cross</th>
            </tr>
          </thead>
          <tbody>
            {veredicto.tabla.map((fila, index) => (
              <tr class={index % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="p-3 border-b border-gray-200 font-bold text-[#3A3A3C]">{fila.atributo}</td>
                <td class="p-3 border-b border-gray-200 font-bold text-[#00BFFF] border-x border-gray-200 bg-blue-50/30">{fila.nissan}</td>
                <td class="p-3 border-b border-gray-200 text-gray-600 border-r border-gray-200">{fila.chevrolet}</td>
                <td class="p-3 border-b border-gray-200 text-gray-600 border-r border-gray-200">{fila.vw_nivus}</td>
                <td class="p-3 border-b border-gray-200 text-gray-600 border-r border-gray-200">{fila.changan}</td>
                <td class="p-3 border-b border-gray-200 text-gray-600">{fila.vw_tcross}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* FOOTER DEL PDF */}
      <div class="mt-8 pt-4 border-t border-gray-200 text-center text-[9px] text-gray-400 uppercase tracking-widest">
        Documento confidencial - DATACAR Paraguay - datacarpy.com
      </div>
    </div>
  </main>

  {/* BARRA DE ACCIÓN FLOTANTE (NO SE IMPRIME EN EL PDF) */}
  <div class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 shadow-[0_-4px_10px_rgba(0,0,0,0.1)] z-50 no-print">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
      <button onclick="history.back()" class="text-[#3A3A3C] font-medium text-sm hover:underline w-full md:w-auto text-left">
        ← Volver
      </button>
      
      <div class="flex w-full md:w-auto gap-3">
        {/* BOTÓN GENERAR PDF */}
        <button id="btn_pdf" class="flex-1 bg-white border-2 border-[#0A1F33] text-[#0A1F33] font-bold py-3 px-6 text-sm hover:bg-gray-50 transition-colors flex justify-center items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          Descargar PDF
        </button>
        
        {/* BOTÓN CTA MODIFICADO */}
        <button id="btn_avanzar" class="flex-1 bg-[#00BFFF] hover:bg-[#0099cc] text-white font-bold py-3 px-8 text-sm transition-colors flex justify-center items-center gap-2">
          Quiero avanzar con una opción
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <style>
    /* Ocultar elementos UI durante la impresión/generación de PDF */
    @media print {
      .no-print { display: none !important; }
      body { background-color: white; }
      #dossier-pdf-content { box-shadow: none; padding: 0; }
    }
  </style>

  <script>
    // Lógica para Generar PDF usando html2pdf
    document.getElementById('btn_pdf').addEventListener('click', () => {
      const btn = document.getElementById('btn_pdf');
      const originalText = btn.innerHTML;
      btn.innerHTML = 'Generando...';
      
      const element = document.getElementById('dossier-pdf-content');
      
      // Opciones de configuración para máxima calidad
      const opt = {
        margin:       [10, 10, 10, 10], // top, left, bottom, right
        filename:     'Dossier_Inversion_DATACAR.pdf',
        image:        { type: 'jpeg', quality: 1.0 },
        html2canvas:  { scale: 2, useCORS: true, logging: false },
        jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };

      // Ejecutar la librería
      html2pdf().set(opt).from(element).save().then(() => {
        btn.innerHTML = originalText;
      });
    });

    // Lógica del CTA Principal
    document.getElementById('btn_avanzar').addEventListener('click', () => {
      // Aquí abriríamos un modal o enviaríamos el dato final a PostgreSQL
      alert("¡Excelente decisión!\n\nEste evento guardará el registro final en la base de datos y notificará a tu asesor asignado para iniciar la gestión.");
    });
  </script>
</body>
</html>

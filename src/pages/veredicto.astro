---
// src/pages/veredicto.astro

// Datos recuperados de la URL (Paso 1)
const nombreUsuario = Astro.url.searchParams.get('nombre') || "Inversor";
const pMin = Astro.url.searchParams.get('min') || "15,000";
const pMax = Astro.url.searchParams.get('max') || "30,000";
const fechaActual = new Date().toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const veredicto = {
  ganador: {
    marca: "Nissan", modelo: "New Kicks", version: "Sense (2026)", precio: 23990,
    racional: [
      "ADAS Full de serie — 2 de 4 rivales no lo incluyen.",
      "Marca Nissan con red de servicios establecida en Paraguay.",
      "Mejor relación precio-equipamiento del grupo: $23,990 USD."
    ]
  },
  podio: [
    { posicion: 1, marca: "Nissan", modelo: "New Kicks", version: "Sense (2026)", precio: 23990, etiqueta: "RECOMENDACIÓN" },
    { posicion: 2, marca: "Chevrolet", modelo: "Tracker", version: "LTZ (2026)", precio: 21500, etiqueta: "Alternativa #2" },
    { posicion: 3, marca: "Volkswagen", modelo: "Nivus", version: "HL", precio: 24500, etiqueta: "Alternativa #3" }
  ],
  tabla: [
    { atributo: "Precio", nissan: "$23,990", chevrolet: "$21,500", vw_nivus: "$24,500", changan: "$22,700", vw_tcross: "$23,500" },
    { atributo: "Motor/HP", nissan: "1.6L 120hp", chevrolet: "1.2T 130hp", vw_nivus: "1.0T 116hp", changan: "1.5T 185hp", vw_tcross: "1.0T 116hp" },
    { atributo: "Airbags", nissan: "6", chevrolet: "6", vw_nivus: "6", changan: "6", vw_tcross: "6" }
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DATACAR - Dossier de Inversión</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@300;900&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body class="bg-[#F0F2F5] text-[#3A3A3C] font-inter pb-32">

  <header class="bg-[#0A1F33] py-4 px-8 flex justify-between items-center text-white no-print">
    <div class="font-montserrat font-black text-2xl tracking-tight">DATA<span class="font-light text-[#C0C0C0]">CAR</span></div>
    <div class="text-sm">Veredicto Final</div>
  </header>

  <main class="max-w-4xl mx-auto mt-8 px-4">
    <div id="dossier-pdf-content" class="bg-white shadow-xl p-8 md:p-12 relative border-t-8 border-[#0A1F33]">
      
      {/* HEADER DEL DOSSIER */}
      <div class="flex justify-between items-start mb-10 border-b border-gray-100 pb-8">
        <div>
          <div class="font-montserrat font-black text-3xl text-[#0A1F33]">DATA<span class="font-light text-gray-400">CAR</span></div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1">Asesoría Automotriz Independiente</p>
        </div>
        <div class="text-right">
          <div class="bg-gray-50 p-4 border border-gray-100 text-left">
            <p class="text-[9px] text-gray-400 uppercase font-bold">Inversor</p>
            <p class="font-bold text-[#0A1F33] text-sm mb-2">{nombreUsuario}</p>
            <p class="text-[9px] text-gray-400 uppercase font-bold">Rango de Inversión</p>
            <p class="font-bold text-[#0A1F33] text-sm">${pMin} - ${pMax}</p>
          </div>
        </div>
      </div>

      {/* BLOQUE RECOMENDACIÓN PRINCIPAL */}
      <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Recomendación Estratégica</h3>
      <div class="border-2 border-[#0A1F33] p-6 mb-10 bg-white group hover:border-[#00BFFF] transition-colors">
        <div class="flex flex-col md:flex-row gap-8">
          <div class="w-full md:w-1/3 bg-gray-50 border border-gray-100 h-40 flex items-center justify-center text-[10px] text-gray-300 uppercase font-bold tracking-tighter">
            Visualización Vehículo
          </div>
          <div class="w-full md:w-2/3 flex flex-col">
            <div class="flex justify-between items-start mb-2">
                <h2 class="font-montserrat font-black text-2xl text-[#0A1F33] leading-none uppercase">{veredicto.ganador.marca} {veredicto.ganador.modelo}</h2>
                <span class="bg-[#00BFFF] text-white text-[10px] font-bold px-2 py-1">TOP PICK</span>
            </div>
            <p class="text-sm text-gray-500 mb-4">{veredicto.ganador.version} • <span class="font-bold text-[#0A1F33]">${veredicto.ganador.precio.toLocaleString()}</span></p>
            
            <ul class="space-y-2 mb-6 text-xs text-gray-600">
              {veredicto.ganador.racional.map(item => (
                <li class="flex items-center gap-2">
                  <span class="text-[#00BFFF] font-bold">✓</span> {item}
                </li>
              ))}
            </ul>

            {/* CTA GANADOR */}
            <button onclick="alert('Solicitando cotización para el Ganador...')" class="bg-[#00BFFF] hover:bg-[#0099cc] text-white font-bold py-3 px-6 text-xs transition-all self-start uppercase tracking-wide no-print">
              Quiero cotizar este auto
            </button>
          </div>
        </div>
      </div>

      {/* EL PODIO CON CTAs */}
      <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Alternativas de Inversión</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        {veredicto.podio.map(auto => (
          <div class="border border-gray-100 bg-gray-50 p-5 flex flex-col hover:border-[#0A1F33] transition-colors">
            <span class="text-[9px] font-bold text-gray-400 uppercase mb-3">{auto.etiqueta}</span>
            <h4 class="font-bold text-[#0A1F33] text-sm leading-tight mb-1">{auto.marca} {auto.modelo}</h4>
            <p class="text-[10px] text-gray-500 mb-4">${auto.precio.toLocaleString()}</p>
            
            {/* CTA ALTERNATIVAS */}
            <button onclick={`alert('Cotizando alternativa: ${auto.marca} ${auto.modelo}')`} class="mt-auto border border-[#0A1F33] text-[#0A1F33] font-bold py-2 text-[10px] hover:bg-[#0A1F33] hover:text-white transition-all uppercase no-print">
              Quiero cotizar
            </button>
          </div>
        ))}
      </div>

      {/* TABLA COMPARATIVA TÉCNICA */}
      <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Matriz Comparativa de Atributos</h3>
      <div class="overflow-hidden border border-gray-200">
        <table class="w-full text-left text-[10px] border-collapse">
          <thead>
            <tr class="bg-[#0A1F33] text-white">
              <th class="p-3 font-bold uppercase tracking-wider">Atributo</th>
              <th class="p-3 font-bold uppercase bg-[#00BFFF]">Nissan Kicks</th>
              <th class="p-3 font-bold uppercase">Chevy Tracker</th>
              <th class="p-3 font-bold uppercase">VW Nivus</th>
              <th class="p-3 font-bold uppercase">Changan CS55</th>
            </tr>
          </thead>
          <tbody>
            {veredicto.tabla.map((fila, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="p-3 border-b border-gray-100 font-bold">{fila.atributo}</td>
                <td class="p-3 border-b border-gray-100 font-bold text-[#00BFFF] bg-blue-50/20">{fila.nissan}</td>
                <td class="p-3 border-b border-gray-100 text-gray-500">{fila.chevrolet}</td>
                <td class="p-3 border-b border-gray-100 text-gray-500">{fila.vw_nivus}</td>
                <td class="p-3 border-b border-gray-100 text-gray-500">{fila.changan}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-12 pt-4 border-t border-gray-100 text-center text-[8px] text-gray-300 uppercase tracking-widest">
        Dossier Confidencial - Generado por DATACAR Paraguay - {fechaActual}
      </div>
    </div>
  </main>

  {/* BARRA DE ACCIÓN FIJA */}
  <div class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 shadow-2xl z-50 no-print">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
      <button onclick="history.back()" class="text-gray-400 text-xs font-bold hover:text-[#0A1F33] uppercase">← Revisar Selección</button>
      
      <div class="flex gap-3 w-full md:w-auto">
        <button id="btn_pdf" class="flex-1 md:flex-none border-2 border-[#0A1F33] text-[#0A1F33] font-bold py-3 px-8 text-xs hover:bg-gray-50 transition-all uppercase">Descargar PDF</button>
        <button id="btn_final" class="flex-1 md:flex-none bg-[#00BFFF] hover:bg-[#0099cc] text-white font-bold py-3 px-10 text-xs transition-all uppercase tracking-widest">Quiero avanzar con una opción</button>
      </div>
    </div>
  </div>

  <script>
    // GENERACIÓN DE PDF
    document.getElementById('btn_pdf').addEventListener('click', () => {
      const btn = document.getElementById('btn_pdf');
      btn.innerHTML = 'PROCESANDO...';
      const element = document.getElementById('dossier-pdf-content');
      const opt = {
        margin: 10,
        filename: 'Dossier_DATACAR.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2 },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
      };
      // @ts-ignore
      html2pdf().set(opt).from(element).save().then(() => { btn.innerHTML = 'DESCARGAR PDF'; });
    });

    // GUARDADO FINAL
    document.getElementById('btn_final').addEventListener('click', () => {
      alert("✅ Dossier Guardado.\n\nSe ha enviado la notificación al equipo de ventas de DATACAR con este perfil.");
    });
  </script>
</body>
</html>

---
// src/pages/veredicto.astro

// Recuperamos los datos del cliente que vienen viajando por la URL
const nombreUsuario = Astro.url.searchParams.get('nombre') || "Inversor";
const pMin = Astro.url.searchParams.get('min') || "15000";
const pMax = Astro.url.searchParams.get('max') || "30000";

// SIMULACIÓN DEL MOTOR DE VEREDICTO (Backend)
// En producción, tu API evaluará los 5 IDs seleccionados y devolverá este objeto ordenado.
const veredicto = {
  ganador: {
    marca: "Nissan", modelo: "New Kicks", version: "Sense (2026)", precio: 23990,
    racional: [
      "ADAS Full de serie — 2 de 4 rivales no lo incluyen.",
      "Marca con red de servicios establecida en Paraguay — respaldo postventa garantizado.",
      "Mejor relación precio-equipamiento del grupo seleccionado."
    ]
  },
  podio: [
    { posicion: 2, marca: "Chevrolet", modelo: "Tracker", version: "LTZ (2026)", precio: 21500, racional: "Opción alternativa sólida en motorización — no se descarta." },
    { posicion: 3, marca: "Volkswagen", modelo: "Nivus", version: "HL", precio: 24500, racional: "Tercera opción válida, destaca en reventa y diseño." }
  ],
  descartados: [
    { marca: "Hyundai", modelo: "New Creta", precio: 26990, razon: "Excede el punto óptimo de presupuesto frente al ganador ofreciendo equipamiento similar." },
    { marca: "Changan", modelo: "CS55 PLUS", precio: 24490, razon: "Excelente tecnología, pero penaliza en el filtro de 'Marcas Tradicionales' si el cliente busca máxima liquidez de reventa." }
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DATACAR - Veredicto de Inversión</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@300;900&display=swap" rel="stylesheet">
</head>
<body class="bg-[#F8F9FA] text-[#3A3A3C] font-inter pb-32">

  {/* HEADER CORPORATIVO */}
  <header class="bg-[#0A1F33] py-4 px-8 flex justify-between items-center text-white">
    <div class="font-montserrat font-black text-2xl tracking-tight">DATA<span class="font-light text-[#C0C0C0] tracking-[1px]">CAR</span></div>
    <div class="text-sm font-medium hidden md:block">Autogestión de Inversión</div>
  </header>

  {/* STEPPER NAV */}
  <nav class="bg-white border-b border-gray-200 px-8 py-4 flex justify-between text-sm font-medium">
    <div class="text-gray-400">✓ 1. Tu Perfil</div>
    <div class="text-gray-400">✓ 2. Selección</div>
    <div class="border-b-2 border-[#0A1F33] pb-1 text-[#0A1F33]">3. Veredicto y Ejecución</div>
  </nav>

  <main class="max-w-5xl mx-auto py-10 px-6">
    <div class="mb-8">
      <h1 class="font-montserrat font-black text-3xl text-[#0A1F33] mb-2">Paso 3: Veredicto Analítico</h1>
      <p class="text-sm text-gray-500">
        Inversor: <span class="font-bold text-[#3A3A3C]">{nombreUsuario}</span> • Presupuesto: <span class="font-bold text-[#3A3A3C]">${pMin} – ${pMax}</span>
      </p>
    </div>

    {/* SECCIÓN 1: EL GANADOR (Reemplazamos el amarillo por Authority Blue y Digital Cyan) */}
    <section class="bg-white border-2 border-[#0A1F33] p-6 mb-8 relative">
      <div class="absolute -top-4 left-6 bg-[#0A1F33] text-white px-4 py-1 text-xs font-bold uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4 text-[#00BFFF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Recomendación DATACAR | Lugar #1
      </div>
      
      <div class="flex flex-col md:flex-row gap-8 mt-4">
        <div class="w-full md:w-1/3 bg-gray-100 h-48 flex items-center justify-center text-xs text-gray-400 uppercase tracking-widest border border-gray-200">
          Sin Imagen
        </div>
        <div class="w-full md:w-2/3 flex flex-col">
          <h2 class="font-montserrat font-black text-2xl text-[#0A1F33]">{veredicto.ganador.marca} {veredicto.ganador.modelo}</h2>
          <p class="text-sm text-gray-500 mb-4">{veredicto.ganador.version} • <span class="font-bold text-[#3A3A3C]">${veredicto.ganador.precio.toLocaleString()}</span></p>
          
          <ul class="space-y-3 mb-6 flex-grow text-sm">
            {veredicto.ganador.racional.map(razon => (
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-[#00BFFF] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                <span>{razon}</span>
              </li>
            ))}
          </ul>

          {/* CTA PRINCIPAL DE CONVERSIÓN */}
          <button class="bg-[#00BFFF] hover:bg-[#0099cc] text-white font-bold py-3 px-8 text-sm transition-colors self-start flex items-center gap-2">
            Quiero cotizar este auto
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </div>
      </div>
    </section>

    {/* SECCIÓN 2: ALTERNATIVAS DEL PODIO */}
    <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Alternativas del Podio</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      {veredicto.podio.map(auto => (
        <div class="bg-white border border-gray-200 p-5 flex flex-col h-full">
          <div class="text-xs font-bold text-gray-400 mb-3 uppercase">Lugar #{auto.posicion}</div>
          <div class="flex gap-4 mb-4">
            <div class="w-20 h-14 bg-gray-100 flex-shrink-0 border border-gray-200"></div>
            <div>
              <h4 class="font-bold text-[#0A1F33] leading-tight">{auto.marca} {auto.modelo}</h4>
              <p class="text-xs text-gray-500">{auto.version} • ${auto.precio.toLocaleString()}</p>
            </div>
          </div>
          <div class="mt-auto bg-gray-50 p-3 text-xs border-l-2 border-[#0A1F33] text-[#3A3A3C]">
            {auto.racional}
          </div>
        </div>
      ))}
    </div>

    {/* SECCIÓN 3: NO ALCANZARON EL PODIO (Acordeón) */}
    <details class="group bg-white border border-gray-200 mb-8 cursor-pointer">
      <summary class="flex justify-between items-center p-4 font-medium text-sm list-none">
        <span class="text-[#3A3A3C]">No alcanzaron el podio ({veredicto.descartados.length})</span>
        <span class="transition group-open:rotate-180 text-gray-400">▼</span>
      </summary>
      <div class="p-4 border-t border-gray-100 bg-gray-50 space-y-4">
        {veredicto.descartados.map(auto => (
          <div class="flex flex-col md:flex-row justify-between md:items-center pb-4 border-b border-gray-200 last:border-0 last:pb-0 gap-2">
            <div class="font-bold text-sm text-[#3A3A3C]">{auto.marca} {auto.modelo} <span class="font-normal text-gray-500 ml-2">${auto.precio.toLocaleString()}</span></div>
            <div class="text-xs text-gray-600 md:w-2/3 bg-white p-2 border border-gray-200">{auto.razon}</div>
          </div>
        ))}
      </div>
    </details>

    {/* SECCIÓN 4: CONCLUSIÓN Y PUNTO CIEGO */}
    <div class="space-y-4 mb-10">
      <div class="bg-white border border-gray-200 p-5 border-l-4 border-l-[#0A1F33]">
        <h4 class="font-bold text-sm text-[#0A1F33] mb-2">⚠️ Punto Ciego DATACAR</h4>
        <p class="text-sm text-[#3A3A3C]">Ninguna desventaja crítica detectada para este perfil. La elección del ganador es sólida y bien fundamentada.</p>
      </div>
      <div class="bg-white border border-gray-200 p-5">
        <h4 class="font-bold text-sm text-[#0A1F33] mb-2">Conclusión DATACAR</h4>
        <p class="text-sm text-[#3A3A3C] leading-relaxed">
          El <strong>{veredicto.ganador.marca} {veredicto.ganador.modelo}</strong> logra el mejor balance para el presupuesto ingresado. {veredicto.podio[0].marca} {veredicto.podio[0].modelo} es la alternativa más sólida y no debe descartarse. DATACAR recomienda iniciar el proceso de cotización con el ganador.
        </p>
      </div>
    </div>
  </main>

  {/* BARRA INFERIOR DE ACCIONES (Fija) */}
  <div class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] z-50">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
      <button onclick="history.back()" class="text-[#3A3A3C] font-medium text-sm hover:underline w-full md:w-auto text-left">
        ← Volver a Selección
      </button>
      
      <div class="flex gap-3 w-full md:w-auto">
        <button class="flex-1 md:flex-none bg-white border border-[#0A1F33] text-[#0A1F33] font-bold py-3 px-6 text-sm hover:bg-gray-50 transition-colors">
          Generar PDF
        </button>
        <button id="btn_guardar" class="flex-1 md:flex-none bg-[#0A1F33] hover:bg-gray-800 text-white font-bold py-3 px-8 text-sm transition-colors flex justify-center items-center gap-2">
          Guardar Dossier en Base de Datos
        </button>
      </div>
    </div>
  </div>

  <script>
    // Lógica para enviar TODO al Backend / Base de Datos
    document.getElementById('btn_guardar').addEventListener('click', async (e) => {
      const btn = e.target;
      const originalText = btn.innerHTML;
      
      btn.innerHTML = 'Guardando en PostgreSQL...';
      btn.disabled = true;
      btn.classList.add('opacity-75');

      // 1. Recolectar datos de la URL (Paso 1)
      const urlParams = new URLSearchParams(window.location.search);
      const leadData = {
        nombre: urlParams.get('nombre') || 'Desconocido',
        presupuesto_min: urlParams.get('min'),
        presupuesto_max: urlParams.get('max')
      };

      // 2. Empaquetar con el Veredicto
      // En producción, este payload se envía a tu API route (ej: /api/leads/save)
      const payloadFinal = {
        cliente: leadData,
        fecha_generacion: new Date().toISOString(),
        resultado_algoritmo: {
          ganador: "Nissan New Kicks", // Extraer dinámicamente en prod
          podio: ["Chevrolet Tracker", "Volkswagen Nivus"]
        }
      };

      console.log("🚀 PAYLOAD LISTO PARA VENTAS:", payloadFinal);

      // Simulador de latencia de red
      setTimeout(() => {
        alert("✅ DOSSIER GUARDADO EXITOSAMENTE.\n\nEl equipo de ventas ya tiene acceso a este perfil en la base de datos.");
        btn.innerHTML = originalText;
        btn.disabled = false;
        btn.classList.remove('opacity-75');
      }, 2000);
    });
  </script>
</body>
</html>

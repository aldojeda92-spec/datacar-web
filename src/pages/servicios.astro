---
// src/pages/servicios.astro
---

<html lang="es">
	<head>
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-52KCG6F3');</script>
        <meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
        
        <title>Servicios de Asesoría Automotriz | Compra y Venta de Autos | Datacar</title>
        <meta name="description" content="¿Buscás un 0km o querés vender tu usado? En Datacar filtramos el mercado por vos, realizamos inspecciones técnicas y negociamos el mejor precio. Servicio 0km gratuito." />

        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Service",
          "provider": {
            "@type": "LocalBusiness",
            "name": "Datacar"
          },
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "Servicios Automotrices",
            "itemListElement": [
              {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": "Asesoría 0km" }
              },
              {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": "Venta de Usados" }
              },
              {
                "@type": "Offer",
                "itemOffered": { "@type": "Service", "name": "Shopper de Usados" }
              }
            ]
          }
        }
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@300;900&display=swap" rel="stylesheet">
        
        <style>
            h1, h2, h3, .brand-font { font-family: 'Montserrat', sans-serif; }
            body, p, a { font-family: 'Inter', sans-serif; }
            html { scroll-behavior: smooth; }
            .service-card { transition: all 0.3s ease; }
            .service-card:hover { transform: translateY(-5px); }
        </style>
        <script src="https://cdn.tailwindcss.com"></script>
	</head>
	<body class="bg-white text-[#3A3A3C] antialiased">
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-52KCG6F3" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

		<nav class="w-full z-50 py-6 px-4 bg-[#0A1F33]">
			<div class="max-w-7xl mx-auto flex justify-between items-center">
                <a href="/" class="flex items-center group">
                    <span class="text-2xl font-[900] text-white">DATA</span>
                    <span class="text-2xl font-[300] text-[#C0C0C0] tracking-[1px]">CAR</span>
                </a>
				<div class="hidden md:flex space-x-8 items-center text-sm font-bold text-white uppercase tracking-widest">
					<a href="/" class="hover:text-[#00BFFF] transition">Inicio</a>
					<a href="/catalogo" class="hover:text-[#00BFFF] transition">Catálogo</a>
				</div>
			</div>
		</nav>

        <header class="bg-[#0A1F33] pt-20 pb-32 px-4 text-center">
            <div class="max-w-4xl mx-auto">
                <h1 class="text-3xl md:text-5xl font-[900] text-white mb-6 leading-tight uppercase tracking-tight">
                    Servicios de Asesoría Automotriz en Paraguay
                </h1>
                <p class="text-xl text-[#00BFFF] font-light max-w-2xl mx-auto">
                    Nosotros hacemos el trabajo sucio para que vos disfrutes tu próximo auto.
                </p>
            </div>
        </header>

        <div class="sticky top-0 bg-gray-100 border-b border-gray-200 z-40 overflow-x-auto shadow-sm">
            <div class="max-w-7xl mx-auto flex justify-center whitespace-nowrap py-4 px-4 gap-8 md:gap-16">
                <a href="#asesoria-0km" class="text-xs font-black uppercase tracking-widest text-[#0A1F33] hover:text-[#00BFFF]">Asesoría 0km</a>
                <a href="#venta-usado" class="text-xs font-black uppercase tracking-widest text-[#0A1F33] hover:text-[#00BFFF]">Vender mi Auto</a>
                <a href="#shopper-usados" class="text-xs font-black uppercase tracking-widest text-[#0A1F33] hover:text-[#00BFFF]">Comprar Usado</a>
            </div>
        </div>

        <main class="max-w-7xl mx-auto px-4 py-20">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                
                <section id="asesoria-0km" class="service-card flex flex-col bg-gray-50 rounded-3xl overflow-hidden shadow-sm border border-gray-100">
                    <div class="h-48 bg-gray-200 relative overflow-hidden">
                        <img src="https://media.puntal.com.ar/p/b7993049ae27eb6529ca8e4cbd72312a/adjuntos/270/imagenes/001/588/0001588588/1200x0/smart/autos0kmjpg.jpg" alt="Asesoría 0km" class="w-full h-full object-cover" loading="lazy" />
                        <div class="absolute top-4 left-4 bg-[#00BFFF] text-[#0A1F33] text-[10px] font-black px-3 py-1 rounded-full uppercase">Costo Cero</div>
                    </div>
                    <div class="p-8 flex-grow flex flex-col">
                        <h2 class="text-2xl font-[900] text-[#0A1F33] mb-4 uppercase">Asesoría 0km Premium</h2>
                        <p class="text-sm text-gray-600 leading-relaxed mb-6 flex-grow">
                            Buscamos disponibilidad de stock en todas las marcas y negociamos el precio final por vos. <br/><br/>
                            <strong>¿Por qué es gratis?</strong> Gracias a convenios directos con representantes oficiales en Paraguay por acercarles compradores decididos. Vos ahorrás tiempo y dinero, sin pagar un guaraní extra.
                        </p>
                        <a href="https://wa.me/595991244469?text=Hola%20Datacar,%20quiero%20asesor%C3%ADa%20para%20un%200km." 
                           target="_blank"
                           class="w-full bg-[#0A1F33] hover:bg-[#00BFFF] hover:text-[#0A1F33] text-white text-center font-black py-4 rounded-xl transition-all uppercase text-xs tracking-widest">
                            Hablar con un Asesor
                        </a>
                    </div>
                </section>

                <section id="venta-usado" class="service-card flex flex-col bg-gray-50 rounded-3xl overflow-hidden shadow-sm border border-gray-100">
                    <div class="h-48 bg-gray-200 relative overflow-hidden">
                        <img src="/service-venta.webp" alt="Venta de usado" class="w-full h-full object-cover" loading="lazy" />
                        <div class="absolute top-4 left-4 bg-white text-[#0A1F33] text-[10px] font-black px-3 py-1 rounded-full uppercase">Inversión: 2.5% comisión</div>
                    </div>
                    <div class="p-8 flex-grow flex flex-col">
                        <h2 class="text-2xl font-[900] text-[#0A1F33] mb-4 uppercase">Gestión de Venta</h2>
                        <p class="text-sm text-gray-600 leading-relaxed mb-6 flex-grow">
                            Publicamos tu auto en los portales más importantes, filtramos a los curiosos y solo te llevamos ofertas reales. <br/><br/>
                            <strong>Inversión:</strong> 2.5% de comisión (Solo si vendemos). Nos encargamos de las fotos profesionales y la negociación para que no pierdas tiempo con desconocidos.
                        </p>
                        <a href="https://wa.me/595991244469?text=Hola%20Datacar,%20quiero%20vender%20mi%20usado." 
                           target="_blank"
                           class="w-full bg-[#00BFFF] hover:bg-[#33CCFF] text-[#0A1F33] text-center font-black py-4 rounded-xl transition-all uppercase text-xs tracking-widest shadow-lg">
                            Vender mi auto ahora
                        </a>
                    </div>
                </section>

                <section id="shopper-usados" class="service-card flex flex-col bg-gray-50 rounded-3xl overflow-hidden shadow-sm border border-gray-100">
                    <div class="h-48 bg-gray-200 relative overflow-hidden">
                        <img src="/service-shopper.webp" alt="Shopper de usados" class="w-full h-full object-cover" loading="lazy" />
                        <div class="absolute top-4 left-4 bg-white text-[#0A1F33] text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-tighter">Gs. 350.000</div>
                    </div>
                    <div class="p-8 flex-grow flex flex-col">
                        <h2 class="text-2xl font-[900] text-[#0A1F33] mb-4 uppercase">Shopper de Usados</h2>
                        <p class="text-sm text-gray-600 leading-relaxed mb-6 flex-grow">
                            ¿Viste un auto pero tenés miedo de que esté roto? Vamos con vos. <br/><br/>
                            <strong>Inversión: Gs. 350.000.</strong> Ahorrate millones detectando fallas ocultas antes de comprar o dejando que nosotros negociemos el precio final por vos para cubrir nuestro fee.
                        </p>
                        <a href="https://wa.me/595991244469?text=Hola%20Datacar,%20necesito%20un%20shopper%20de%20usados." 
                           target="_blank"
                           class="w-full bg-[#0A1F33] hover:bg-[#00BFFF] hover:text-[#0A1F33] text-white text-center font-black py-4 rounded-xl transition-all uppercase text-xs tracking-widest">
                            Solicitar Shopper
                        </a>
                    </div>
                </section>

            </div>
        </main>

        <footer class="bg-[#05111D] text-gray-500 py-16 text-center border-t border-[#1A3A5C]">
            <p class="text-xs opacity-40">© 2026 DATACAR EAS. Gestión inteligente de inversiones automotrices.</p>
        </footer>

        <a href="https://wa.me/595991244469?text=Hola%20Datacar,%20necesito%20asesor%C3%ADa%20automotriz." 
           target="_blank" 
           class="fixed bottom-6 right-6 z-50 bg-[#25D366] text-white p-4 rounded-full shadow-2xl hover:scale-110 transition-transform duration-300 md:hidden"
           onclick="window.dataLayer = window.dataLayer || []; window.dataLayer.push({'event': 'whatsapp_click', 'location': 'sticky_servicios'});">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </a>
	</body>
</html>

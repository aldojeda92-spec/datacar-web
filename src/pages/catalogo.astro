---
// src/pages/catalogo.astro
// CATÁLOGO CONECTADO A GOOGLE SHEETS EN TIEMPO REAL (AHORA CON FILTRO DE TRANSMISIÓN)
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Catálogo de Vehículos | Datacar EAS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@300;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js" is:inline></script>
</head>
<body class="bg-gray-50 text-[#3A3A3C] antialiased flex flex-col min-h-screen">

    <nav class="bg-[#0A1F33] py-5 px-4 shadow-md">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a href="/" class="flex items-center group" style="font-family: 'Montserrat', sans-serif;">
                <span class="text-2xl md:text-3xl font-[900] text-white leading-none">DATA</span>
                <span class="text-2xl md:text-3xl font-[300] text-[#C0C0C0] leading-none tracking-[1px]">CAR</span>
            </a>
            <div class="hidden md:flex space-x-8 items-center" style="font-family: 'Inter', sans-serif;">
                <a href="/servicios" class="text-white font-medium hover:text-[#00BFFF] transition text-sm tracking-wide">SERVICIOS</a>
                <a href="https://wa.me/595991244469?text=Hola%20Datacar,%20quiero%20vender%20mi%20auto%20y%20me%20gustar%C3%ADa%20conocer%20el%20proceso." target="_blank" class="text-white font-medium hover:text-[#00BFFF] transition text-sm tracking-wide">VENDER MI AUTO</a>
                <a href="/catalogo" class="text-[#00BFFF] font-medium transition text-sm tracking-wide border-b-2 border-[#00BFFF] pb-1">CATÁLOGO</a>
            </div>
            <a href="/" class="md:hidden text-white text-sm font-bold border border-white px-4 py-1 rounded-full">Volver</a>
        </div>
    </nav>

    <section class="bg-[#0A1F33] text-white py-12 text-center px-4">
        <h1 class="text-3xl md:text-4xl font-[900] mb-4" style="font-family: 'Montserrat', sans-serif;">Unidades Aprobadas</h1>
        <p class="text-base text-[#C0C0C0] max-w-2xl mx-auto font-light leading-relaxed" style="font-family: 'Inter', sans-serif;">
            Vehículos inspeccionados con precios basados en datos de mercado reales, listos para transferencia.
        </p>
    </section>

    <section class="bg-white border-b border-gray-200 py-4 px-4 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row gap-4 justify-between items-center" style="font-family: 'Inter', sans-serif;">
            
            <div class="flex flex-col md:flex-row gap-4 w-full md:w-auto flex-wrap">
                <div class="flex items-center gap-2">
                    <label for="filtro-tipo" class="text-sm font-bold text-[#0A1F33]">Categoría:</label>
                    <select id="filtro-tipo" class="bg-gray-50 border border-gray-300 text-gray-700 text-sm rounded-lg focus:ring-[#00BFFF] focus:border-[#00BFFF] block p-2.5 outline-none">
                        <option value="todos">Todos</option>
                        <option value="suv">SUV</option>
                        <option value="pickup">Pick-ups</option>
                        <option value="sedan">Sedán</option>
                        <option value="hatchback">Hatchback</option>
                    </select>
                </div>

                <div class="flex items-center gap-2">
                    <label for="filtro-transmision" class="text-sm font-bold text-[#0A1F33]">Transmisión:</label>
                    <select id="filtro-transmision" class="bg-gray-50 border border-gray-300 text-gray-700 text-sm rounded-lg focus:ring-[#00BFFF] focus:border-[#00BFFF] block p-2.5 outline-none">
                        <option value="todos">Todas</option>
                        <option value="automatica">Automática</option>
                        <option value="manual">Manual</option>
                    </select>
                </div>

                <div class="flex items-center gap-2">
                    <label for="filtro-precio" class="text-sm font-bold text-[#0A1F33]">Presupuesto:</label>
                    <select id="filtro-precio" class="bg-gray-50 border border-gray-300 text-gray-700 text-sm rounded-lg focus:ring-[#00BFFF] focus:border-[#00BFFF] block p-2.5 outline-none">
                        <option value="todos">Sin límite</option>
                        <option value="hasta-30">Hasta US$ 30.000</option>
                        <option value="30-a-50">US$ 30.000 a US$ 50.000</option>
                        <option value="mas-50">Más de US$ 50.000</option>
                    </select>
                </div>
            </div>

            <div class="text-sm text-gray-500 font-medium" id="contador-resultados">
                Cargando vehículos...
            </div>
            
        </div>
    </section>

    <section class="py-12 px-4 flex-grow bg-gray-50 min-h-[500px]">
        <div class="max-w-7xl mx-auto">
            
            <div id="loader" class="text-center py-20">
                <div class="inline-block animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-[#00BFFF]"></div>
                <p class="mt-4 text-gray-500 font-bold" style="font-family: 'Inter', sans-serif;">Sincronizando con base de datos...</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="grid-vehiculos">
            </div>

            <div id="mensaje-vacio" class="hidden text-center py-20">
                <p class="text-xl text-gray-500 font-light" style="font-family: 'Inter', sans-serif;">No encontramos unidades que coincidan con esos filtros.</p>
                <button onclick="document.getElementById('filtro-tipo').value='todos'; document.getElementById('filtro-transmision').value='todos'; document.getElementById('filtro-precio').value='todos'; document.getElementById('filtro-tipo').dispatchEvent(new Event('change'));" class="mt-4 text-[#00BFFF] font-bold hover:underline">Limpiar filtros</button>
            </div>

        </div>
    </section>

    <footer class="bg-[#05111D] text-gray-500 py-16 text-center border-t border-[#1A3A5C]">
        <div class="flex items-center justify-center mb-6" style="font-family: 'Montserrat', sans-serif;">
            <span class="text-2xl font-[900] text-white leading-none opacity-70">DATA</span>
            <span class="text-2xl font-[300] text-[#C0C0C0] leading-none tracking-[1px] opacity-70">CAR</span>
        </div>
        <p class="font-light text-sm mb-6" style="font-family: 'Inter', sans-serif;">Gestión de inversiones automotrices</p>
        <p class="text-xs opacity-40" style="font-family: 'Inter', sans-serif;">© 2024 DATACAR EAS.</p>
    </footer>

    <script is:inline>
        const URL_GOOGLE_SHEETS = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSyfwObQ6J1jGycoeHlr_edfLLvz85rfKMKNJ3MmxShzDN2orGeUgwoDTOwJPzh9k5z3lINmxXjX_hG/pub?output=csv";

        document.addEventListener('DOMContentLoaded', () => {
            const grid = document.getElementById('grid-vehiculos');
            const loader = document.getElementById('loader');
            const filtroTipo = document.getElementById('filtro-tipo');
            const filtroPrecio = document.getElementById('filtro-precio');
            const filtroTransmision = document.getElementById('filtro-transmision');
            const contador = document.getElementById('contador-resultados');
            const mensajeVacio = document.getElementById('mensaje-vacio');
            let vehiculosData = [];

            if (URL_GOOGLE_SHEETS && URL_GOOGLE_SHEETS.includes("docs.google.com")) {
                Papa.parse(URL_GOOGLE_SHEETS, {
                    download: true,
                    header: true,
                    complete: function(results) {
                        vehiculosData = results.data.filter(auto => auto.codigo && auto.marca);
                        loader.style.display = 'none';
                        dibujarTarjetas();
                    },
                    error: function(err) {
                        loader.innerHTML = "<p class='text-red-500 font-bold'>Hubo un error al conectar con el inventario.</p>";
                    }
                });
            } else {
                loader.innerHTML = "<p class='text-red-500 font-bold'>Falta configurar el enlace de Google Sheets en el código.</p>";
            }

            function dibujarTarjetas() {
                grid.innerHTML = ''; 
                const tipoVal = filtroTipo.value;
                const precioVal = filtroPrecio.value;
                const transVal = filtroTransmision.value;
                let visibles = 0;

                vehiculosData.forEach(auto => {
                    const autoPrecio = parseInt(auto.precioValor);
                    
                    // Lógica Tipo
                    const coincideTipo = (tipoVal === 'todos' || (auto.tipo && auto.tipo.toLowerCase() === tipoVal.toLowerCase()));
                    
                    // Lógica Precio
                    let coincidePrecio = true;
                    if (precioVal === 'hasta-30') coincidePrecio = autoPrecio <= 30000;
                    if (precioVal === '30-a-50') coincidePrecio = (autoPrecio > 30000 && autoPrecio <= 50000);
                    if (precioVal === 'mas-50') coincidePrecio = autoPrecio > 50000;

                    // Lógica Transmisión (Soporta "Auto", "Automática", "manual", etc.)
                    let coincideTransmision = true;
                    if (transVal !== 'todos' && auto.transmision) {
                        const transTexto = auto.transmision.toLowerCase();
                        if (transVal === 'automatica') {
                            coincideTransmision = transTexto.includes('auto');
                        } else if (transVal === 'manual') {
                            coincideTransmision = transTexto.includes('man');
                        }
                    } else if (transVal !== 'todos' && !auto.transmision) {
                        // Si se filtra pero el auto no tiene el dato cargado en excel
                        coincideTransmision = false; 
                    }

                    if (coincideTipo && coincidePrecio && coincideTransmision) {
                        visibles++;
                        
                        let htmlEtiqueta = '';
                        if(auto.etiqueta && auto.etiqueta.trim() !== "") {
                            const colorE = auto.colorEtiqueta || "bg-[#00BFFF] text-[#0A1F33]";
                            htmlEtiqueta = `<div class="absolute top-4 left-4 z-10 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider ${colorE}">${auto.etiqueta}</div>`;
                        }

                        // Dato de transmisión a mostrar
                        const transmisionMostrar = auto.transmision ? auto.transmision : 'N/D';

                        const cardHTML = `
                            <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden group hover:shadow-xl transition-shadow duration-300">
                                <div class="relative h-56 overflow-hidden bg-gray-200">
                                    ${htmlEtiqueta}
                                    <img src="${auto.imagen}" alt="${auto.marca} ${auto.modelo}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='https://via.placeholder.com/800x600?text=Foto+Pendiente'" />
                                </div>
                                
                                <div class="p-6">
                                    <div class="flex justify-between items-center mb-1">
                                        <h3 class="text-sm font-bold text-gray-400 uppercase tracking-widest" style="font-family: 'Inter', sans-serif;">${auto.marca}</h3>
                                        <span class="text-xs font-mono font-bold text-[#0A1F33] bg-gray-100 px-2 py-1 rounded-md border border-gray-200">
                                            REF: ${auto.codigo}
                                        </span>
                                    </div>
                                    
                                    <h2 class="text-xl font-[900] text-[#0A1F33] mb-4 line-clamp-1" style="font-family: 'Montserrat', sans-serif;">${auto.modelo}</h2>
                                    
                                    <div class="flex items-center justify-between text-xs sm:text-sm text-gray-600 mb-6 pb-6 border-b border-gray-100" style="font-family: 'Inter', sans-serif;">
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4 text-[#00BFFF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                            ${auto.ano}
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4 text-[#00BFFF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                                            ${auto.kilometraje}
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4 text-[#00BFFF]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
                                            <span class="truncate max-w-[80px]">${transmisionMostrar}</span>
                                        </div>
                                    </div>
                                    
                                    <div class="flex items-center justify-between">
                                        <span class="text-2xl font-[900] text-[#0A1F33]" style="font-family: 'Montserrat', sans-serif;">${auto.precio}</span>
                                        <a href="https://wa.me/595991244469?text=Hola%20Datacar,%20estoy%20interesado%20en%20el%20veh%C3%ADculo%20[REF:%20${auto.codigo}]%20-%20${auto.marca}%20${auto.modelo}" target="_blank" class="bg-[#00BFFF] hover:bg-[#0099CC] text-[#0A1F33] font-bold py-2 px-4 rounded-lg transition-colors text-sm">
                                            Me interesa
                                        </a>
                                    </div>
                                </div>
                            </div>
                        `;
                        grid.innerHTML += cardHTML;
                    }
                });

                contador.textContent = `Mostrando ${visibles} unidad${visibles !== 1 ? 'es' : ''}`;
                
                if (visibles === 0) {
                    mensajeVacio.classList.remove('hidden');
                } else {
                    mensajeVacio.classList.add('hidden');
                }
            }

            filtroTipo.addEventListener('change', dibujarTarjetas);
            filtroPrecio.addEventListener('change', dibujarTarjetas);
            filtroTransmision.addEventListener('change', dibujarTarjetas);
        });
    </script>
</body>
</html>

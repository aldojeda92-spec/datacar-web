---
// src/pages/miauto.astro
// PÁGINA DEL ASISTENTE DE IA (VOICEFLOW) - ANTI OVERFLOW Y FUENTE CORREGIDA
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <title>Mi Auto | Asistente IA de Datacar EAS</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@300;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-[#3A3A3C] antialiased flex flex-col min-h-screen">

    <nav class="bg-[#0A1F33] py-5 px-4 shadow-md">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a href="/" class="flex items-center group" style="font-family: 'Montserrat', sans-serif;">
                <span class="text-2xl md:text-3xl font-[900] text-white leading-none">DATA</span>
                <span class="text-2xl md:text-3xl font-[300] text-[#C0C0C0] leading-none tracking-[1px]">CAR</span>
            </a>
            <div class="hidden md:flex space-x-6 text-sm font-bold tracking-wide" style="font-family: 'Inter', sans-serif;">
                <a href="/servicios" class="text-white hover:text-[#00BFFF] transition">SERVICIOS</a>
                <a href="https://wa.me/595991244469?text=Hola%20Datacar,%20quiero%20vender%20mi%20auto%20y%20me%20gustar%C3%ADa%20conocer%20el%20proceso." target="_blank" class="text-white hover:text-[#00BFFF] transition">VENDER MI AUTO</a>
                <a href="/catalogo" class="text-white hover:text-[#00BFFF] transition">CATÁLOGO</a>
                <a href="/nosotros" class="text-white hover:text-[#00BFFF] transition">NOSOTROS</a>
            </div>
            <a href="/" class="md:hidden flex items-center gap-2 text-white font-bold text-sm border border-white px-4 py-1 rounded-full">
                Volver
            </a>
        </div>
    </nav>

    <section class="bg-[#0A1F33] text-white py-12 text-center px-4">
        <h1 class="text-3xl md:text-4xl font-[900] mb-4" style="font-family: 'Montserrat', sans-serif;">Asistente Virtual 24/7</h1>
        <p class="text-base text-[#C0C0C0] max-w-2xl mx-auto font-light leading-relaxed" style="font-family: 'Inter', sans-serif;">
            Resolvé tus dudas y empezá la búsqueda de tu próximo 0km en tiempo real con nuestra IA experta.
        </p>
    </section>

    <section class="py-10 px-4 flex-grow bg-gray-50 flex justify-center items-start">
        <div class="w-full max-w-4xl flex flex-col">
            
            <div class="bg-white rounded-3xl shadow-2xl border border-gray-200 relative flex flex-col w-full" style="height: 650px; max-height: 75vh;">
                
                <div id="voiceflow-chat-container" class="w-full h-full relative" style="overflow: hidden; flex-grow: 1;"></div>

            </div>

            <p class="text-center text-xs text-gray-400 mt-6" style="font-family: 'Inter', sans-serif;">
                La inteligencia artificial puede cometer errores. Ante cualquier duda comercial, <a href="https://wa.me/595991244469" target="_blank" class="text-[#00BFFF] font-bold hover:underline">contactanos por WhatsApp</a>.
            </p>
        </div>
    </section>

    <footer class="bg-[#05111D] text-gray-500 py-16 text-center border-t border-[#1A3A5C]">
        <div class="flex items-center justify-center mb-6" style="font-family: 'Montserrat', sans-serif;">
            <span class="text-2xl font-[900] text-white leading-none opacity-70">DATA</span>
            <span class="text-2xl font-[300] text-[#C0C0C0] leading-none tracking-[1px] opacity-70">CAR</span>
        </div>
        <p class="font-light text-sm mb-6" style="font-family: 'Inter', sans-serif;">Gestión de inversiones automotrices</p>
        <p class="text-xs opacity-40" style="font-family: 'Inter', sans-serif;">© 2026 DATACAR EAS.</p>
    </footer>

    <script type="text/javascript" is:inline>
      (function(d, t) {
          var v = d.createElement(t), s = d.getElementsByTagName(t)[0];
          v.onload = function() {
            
            // 1. Creamos el diseño virtual forzando la tipografía "Inter"
            var customCSS = "@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap'); * { font-family: 'Inter', sans-serif !important; }";
            var cssUrl = 'data:text/css;charset=utf-8,' + encodeURIComponent(customCSS);

            window.voiceflow.chat.load({
              verify: { projectID: '69c68fa6a1f89e8a5486cfd5' },
              url: 'https://general-runtime.voiceflow.com',
              versionID: 'production',
              voice: {
                url: "https://runtime-api.voiceflow.com"
              },
              render: {
                mode: 'embedded',
                target: document.getElementById('voiceflow-chat-container')
              },
              // 2. Inyectamos el diseño directamente al asistente
              assistant: {
                stylesheet: cssUrl
              }
            });
          }
          v.src = "https://cdn.voiceflow.com/widget-next/bundle.mjs"; 
          v.type = "text/javascript"; 
          s.parentNode.insertBefore(v, s);
      })(document, 'script');
    </script>

</body>
</html>

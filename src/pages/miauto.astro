<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DATACAR | Gestión de Inversiones Automotrices</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@300;900&display=swap" rel="stylesheet">
    
    <style>
        /* Reset y Filosofía de Transparencia */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #FFFFFF;
            color: #3A3A3C; /* Data Charcoal */
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        /* Header Corporativo - Authority Blue */
        header {
            background-color: #0A1F33; 
            padding: 1.5rem;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            z-index: 10;
        }

        /* Logotipo (Wordmark Dual) - Montserrat 900 vs 300 */
        .logo {
            font-family: 'Montserrat', sans-serif;
            font-size: 2rem;
            text-transform: uppercase;
            letter-spacing: -0.5px;
            user-select: none;
        }

        .logo-data {
            font-weight: 900; 
            color: #FFFFFF; /* White */
        }

        .logo-car {
            font-weight: 300; 
            color: #C0C0C0; /* Silver Light */
            letter-spacing: 1px; /* Tracking +1px según manual */
        }

        /* Contenedor Principal */
        main {
            flex: 1;
            display: flex;
            background-color: #F8F9FA;
            padding: 20px;
            justify-content: center;
        }

        /* Contenedor del Chat (Enfoque B2B / Premium) */
        #chat-wrapper {
            width: 100%;
            max-width: 1000px;
            background: #FFFFFF;
            border-radius: 8px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.05);
            overflow: hidden;
            border: 1px solid #E1E4E8;
        }

        #chat-container {
            width: 100%;
            height: 100%;
        }

        footer {
            background: #FFFFFF;
            text-align: center;
            padding: 10px;
            font-size: 0.75rem;
            color: #3A3A3C;
            border-top: 1px solid #EEEEEE;
        }

        @media (max-width: 768px) {
            main { padding: 0; }
            #chat-wrapper { border-radius: 0; border: none; }
            .logo { font-size: 1.5rem; }
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">
            <span class="logo-data">DATA</span><span class="logo-car">CAR</span>
        </div>
    </header>

    <main>
        <div id="chat-wrapper">
            <div id="chat-container"></div>
        </div>
    </main>

    <footer>
        DATACAR Paraguay © 2026 | Transparencia y Ejecución Premium
    </footer>

    <script type="text/javascript">
      (function(d, t) {
          var v = d.createElement(t), s = d.getElementsByTagName(t)[0];
          v.onload = function() {
            window.voiceflow.chat.load({
              verify: { projectID: '69c68fa6a1f89e8a5486cfd5' },
              url: 'https://general-runtime.voiceflow.com',
              versionID: 'production',
              theme: {
                primaryColor: '#00BFFF', // Digital Cyan (Color de Acento oficial)
                fontFamily: 'Inter',      // Tipografía secundaria operativa
                showPoweredBy: false      // Limpieza visual premium
              },
              voice: {
                url: "https://runtime-api.voiceflow.com"
              },
              render: {
                mode: 'embedded',
                target: document.getElementById('chat-container')
              }
            });
          }
          v.src = "https://cdn.voiceflow.com/widget-next/bundle.mjs"; 
          v.type = "text/javascript"; 
          s.parentNode.insertBefore(v, s);
      })(document, 'script');
    </script>

</body>
</html>

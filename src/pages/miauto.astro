<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DATACAR | Gestión de Inversiones Automotrices</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;900&display=swap" rel="stylesheet">
    
    <style>
        * { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
        }
        
        body {
            font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
            background-color: #F8F9FA;
            color: #3A3A3C;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden; 
            /* Optimizadores para que la fuente se vea ultra nítida */
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
        }

        header {
            background-color: #0A1F33; 
            padding: 1.5rem;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            z-index: 10;
            flex-shrink: 0; 
        }

        .logo { 
            font-size: 2rem; 
            text-transform: uppercase; 
            letter-spacing: -0.5px; 
            user-select: none; 
        }
        
        .logo-data { font-weight: 900; color: #FFFFFF; }
        .logo-car { font-weight: 300; color: #C0C0C0; letter-spacing: 1px; }

        main {
            flex: 1; 
            display: flex;
            padding: 20px;
            justify-content: center;
            align-items: center; 
            min-height: 0; 
        }

        #chat-wrapper {
            width: 100%;
            max-width: 1000px;
            height: 100%; 
            max-height: 800px; 
            background: #FFFFFF;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
            border: 1px solid #E1E4E8;
            overflow: hidden; 
            display: flex;
            flex-direction: column;
        }

        #chat-container {
            width: 100%;
            height: 100%;
            flex: 1;
        }

        footer {
            background: #FFFFFF;
            text-align: center;
            padding: 12px;
            font-size: 0.8rem;
            font-weight: 500;
            color: #6C757D;
            border-top: 1px solid #EEEEEE;
            flex-shrink: 0;
        }

        @media (max-width: 768px) {
            main { padding: 0; align-items: stretch; }
            #chat-wrapper { border-radius: 0; border: none; max-height: none; }
            .logo { font-size: 1.5rem; }
        }
    </style>
</head>
<body>

    <header>
        <div class="logo"><span class="logo-data">DATA</span><span class="logo-car">CAR</span></div>
    </header>

    <main>
        <div id="chat-wrapper">
            <div id="chat-container"></div>
        </div>
    </main>

    <footer>DATACAR Paraguay © 2026 | Transparencia y Ejecución Premium</footer>

    <script type="text/javascript">
      (function(d, t) {
          var v = d.createElement(t), s = d.getElementsByTagName(t)[0];
          v.onload = function() {
            window.voiceflow.chat.load({
              verify: { projectID: '69c68fa6a1f89e8a5486cfd5' },
              url: 'https://general-runtime.voiceflow.com',
              versionID: 'production',
              theme: {
                primaryColor: '#00BFFF',
                /* Cambiamos a Montserrat y agregamos system fallback para asegurar nitidez */
                fontFamily: "'Montserrat', system-ui, sans-serif",
                showPoweredBy: false
              },
              voice: { url: "https://runtime-api.voiceflow.com" },
              render: {
                mode: 'embedded',
                target: document.getElementById('chat-container')
              }
            });
          }
          v.src = "https://cdn.voiceflow.com/widget-next/bundle.mjs"; 
          v.type = "text/javascript"; 
          s.parentNode.insertBefore(v, s);
      })(document, 'script');
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DATACAR | Asesoría Automotriz</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@300;900&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'authority-blue': '#0033A0',
                        'data-charcoal': '#3A3A3C',
                        'silver-light': '#C0C0C0',
                        'digital-cyan': '#00BFFF',
                    },
                    fontFamily: {
                        'montserrat': ['Montserrat', 'sans-serif'],
                        'inter': ['Inter', 'sans-serif'],
                    },
                    letterSpacing: {
                        'car-tracking': '1px',
                    }
                }
            }
        }
    </script>
    <style>
        /* Contenedor del bot estilizado para resaltar sobre el fondo oscuro */
        #voiceflow-container {
            width: 100%;
            height: 650px;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            border: 2px solid #00BFFF; /* Acento Digital Cyan */
            background-color: #FFFFFF;
        }
    </style>
</head>
<body class="bg-authority-blue text-white font-inter min-h-screen flex flex-col">

    <header class="border-b border-white/10 sticky top-0 z-50 bg-authority-blue/95 backdrop-blur-sm">
        <div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">
            
            <a href="/" class="flex items-center">
                <span class="font-montserrat font-black text-white text-3xl">DATA</span><span class="font-montserrat font-light text-silver-light text-3xl tracking-car-tracking">CAR</span>
            </a>
            
            <nav class="hidden md:flex items-center space-x-8">
                <a href="/servicios" class="text-silver-light hover:text-white transition font-medium text-sm tracking-wide">SERVICIOS</a>
                <a href="/nosotros" class="text-silver-light hover:text-white transition font-medium text-sm tracking-wide">NOSOTROS</a>
                <a href="/catalogo" class="text-silver-light hover:text-white transition font-medium text-sm tracking-wide">CATÁLOGO</a>
                <a href="/agendar" class="px-6 py-2.5 bg-digital-cyan text-authority-blue rounded font-bold text-sm hover:opacity-90 transition shadow-lg tracking-wide">AGENDAR</a>
            </nav>
        </div>
    </header>

    <main class="flex-grow flex items-center">
        <div class="max-w-7xl mx-auto px-6 py-12 w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            
            <div class="pr-0 lg:pr-10">
                <div class="inline-block px-3 py-1 border border-digital-cyan text-digital-cyan text-xs font-bold uppercase tracking-widest mb-6 rounded-full">
                    Asesor Inteligente 24/7
                </div>
                <h1 class="text-5xl md:text-6xl font-montserrat font-black text-white leading-tight mb-6 uppercase drop-shadow-md">
                    Gestionamos<br>tu próxima<br>inversión.
                </h1>
                <p class="text-lg text-silver-light mb-8 font-inter leading-relaxed max-w-lg">
                    Eliminamos la fricción del mercado paraguayo. Nuestro sistema cruza tus necesidades operativas con el inventario local en tiempo real para recomendarte la decisión financiera correcta.
                </p>
                
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-1 bg-digital-cyan"></div>
                    <p class="text-sm font-bold text-white uppercase tracking-wider">Inicia tu consulta interactiva</p>
                </div>
            </div>

            <div class="relative w-full">
                <div id="voiceflow-container" class="relative z-10">
                    </div>
            </div>

        </div>
    </main>

    <script type="text/javascript">
      (function(d, t) {
          var v = d.createElement(t), s = d.getElementsByTagName(t)[0];
          v.onload = function() {
            window.voiceflow.chat.load({
              verify: { projectID: '69c68fa6a1f89e8a5486cfd5' },
              url: 'https://general-runtime.voiceflow.com',
              versionID: 'production',
              voice: {
                url: "https://runtime-api.voiceflow.com"
              },
              render: {
                mode: 'embedded',
                target: document.getElementById('voiceflow-container')
              }
            });
          }
          v.src = "https://cdn.voiceflow.com/widget-next/bundle.mjs"; v.type = "text/javascript"; s.parentNode.insertBefore(v, s);
      })(document, 'script');
    </script>
</body>
</html>

---
// src/pages/miauto.astro
// PÁGINA DEL ASISTENTE DE IA (VOICEFLOW)
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DATACAR EAS | Asistente Inteligente</title>
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=Montserrat:wght@300;900&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Contenedor del bot estilizado y con protección de scroll */
        #voiceflow-container {
            width: 100%;
            height: 650px;
            max-height: 75vh;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            border: 2px solid #00BFFF; /* Borde Digital Cyan */
            background-color: #FFFFFF;
            display: flex;
            flex-direction: column;
        }
        
        #voiceflow-container > div {
            flex-grow: 1;
            width: 100%;
            height: 100%;
        }
    </style>
</head>
<body class="bg-[#0A1F33] text-white min-h-screen flex flex-col" style="font-family: 'Inter', sans-serif;">

    <nav class="bg-[#0A1F33] py-5 px-4 shadow-md sticky top-0 z-50 border-b border-white/10">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            
            <a href="/" class="flex items-center group" style="font-family: 'Montserrat', sans-serif;">
                <span class="text-2xl md:text-3xl font-[900] text-white leading-none">DATA</span>
                <span class="text-2xl md:text-3xl font-[300] text-[#C0C0C0] leading-none tracking-[1px]">CAR</span>
            </a>
            
            <div class="hidden md:flex items-center space-x-6 text-sm font-bold tracking-wide">
                <a href="/servicios" class="text-white hover:text-[#00BFFF] transition">SERVICIOS</a>
                <a href="https://wa.me/595991244469?text=Hola%20Datacar,%20quiero%20vender%20mi%20auto%20y%20me%20gustar%C3%ADa%20conocer%20el%20proceso." target="_blank" class="text-white hover:text-[#00BFFF] transition">VENDER MI AUTO</a>
                <a href="/catalogo" class="text-white hover:text-[#00BFFF] transition">CATÁLOGO</a>
                <a href="/nosotros" class="text-white hover:text-[#00BFFF] transition">NOSOTROS</a>
            </div>
            
            <a href="/" class="md:hidden flex items-center gap-2 text-white font-bold text-sm border border-white px-4 py-1 rounded-full">
                Volver
            </a>
        </div>
    </nav>

    <main class="flex-grow flex items-center">
        <div class="max-w-7xl mx-auto px-6 py-12 w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            
            <div class="pr-0 lg:pr-10">
                <div class="inline-block px-4 py-1.5 border border-[#00BFFF] text-[#00BFFF] text-xs font-bold uppercase tracking-widest mb-6 rounded-full">
                    Asistente Virtual 24/7
                </div>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-[900] text-white leading-tight mb-6 drop-shadow-md" style="font-family: 'Montserrat', sans-serif;">
                    Gestionamos<br>tu próxima<br>inversión.
                </h1>
                <p class="text-base lg:text-lg text-[#C0C0C0] mb-8 leading-relaxed max-w-lg font-light">
                    Eliminamos la fricción del mercado paraguayo. Nuestro sistema cruza tus necesidades operativas con el inventario local en tiempo real para recomendarte la decisión financiera correcta.
                </p>
                
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-1 bg-[#00BFFF]"></div>
                    <p class="text-sm font-bold text-white uppercase tracking-wider">Inicia tu consulta interactiva</p>
                </div>
                
                <p class="text-xs text-[#C0C0C0] opacity-80 mt-10">
                    La inteligencia artificial puede cometer errores. Ante cualquier duda comercial, <a href="https://wa.me/595991244469" target="_blank" class="text-[#00BFFF] font-bold hover:underline">contactanos por WhatsApp</a>.
                </p>
            </div>

            <div class="relative w-full">
                <div id="voiceflow-container" class="relative z-10">
                    </div>
            </div>

        </div>
    </main>

    <footer class="bg-[#05111D] text-gray-500 py-16 text-center border-t border-[#1A3A5C]">
        <div class="flex items-center justify-center mb-6" style="font-family: 'Montserrat', sans-serif;">
            <span class="text-2xl font-[900] text-white leading-none opacity-70">DATA</span>
            <span class="text-2xl font-[300] text-[#C0C0C0] leading-none tracking-[1px] opacity-70">CAR</span>
        </div>
        <p class="font-light text-sm mb-6">Gestión de inversiones automotrices</p>
        <p class="text-xs opacity-40">© 2026 DATACAR EAS.</p>
    </footer>

    <script type="text/javascript" is:inline>
      (function(d, t) {
          var v = d.createElement(t), s = d.getElementsByTagName(t)[0];
          v.onload = function() {
            
            // Forzamos tipografía corporativa
            var customCSS = "@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap'); * { font-family: 'Inter', sans-serif !important; }";
            var cssUrl = 'data:text/css;charset=utf-8,' + encodeURIComponent(customCSS);

            window.voiceflow.chat.load({
              verify: { projectID: '69c68fa6a1f89e8a5486cfd5' },
              url: 'https://general-runtime.voiceflow.com',
              versionID: 'production',
              voice: {
                url: "https://runtime-api.voiceflow.com"
              },
              render: {
                mode: 'embedded',
                target: document.getElementById('voiceflow-container')
              },
              assistant: {
                stylesheet: cssUrl
              }
            });
          }
          v.src = "https://cdn.voiceflow.com/widget-next/bundle.mjs"; v.type = "text/javascript"; s.parentNode.insertBefore(v, s);
      })(document, 'script');
    </script>
</body>
</html>
